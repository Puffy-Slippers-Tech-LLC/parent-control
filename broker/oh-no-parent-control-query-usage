#!/usr/bin/python3
"""Query Malcontent usage as the Unix identity selected by the broker."""

from __future__ import annotations

import json
import os
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

TIMER_NAME = "org.freedesktop.MalcontentTimer1"
TIMER_PATH = "/org/freedesktop/MalcontentTimer1"
TIMER_PARENT_INTERFACE = "org.freedesktop.MalcontentTimer1.Parent"
# Leave time for interpreter startup and serialization inside the broker's
# 30-second subprocess deadline. All attempts share this budget.
CALL_TIMEOUT_MS = 25_000
MAX_ATTEMPTS = 3
RETRY_DELAY_SECONDS = 0.2
UINT32_MAX = (1 << 32) - 1


def query_usage(connection, target_uid, *, monotonic=time.monotonic, sleep=time.sleep):
    """Retry a read interrupted by the timer daemon's normal idle shutdown."""
    deadline = monotonic() + CALL_TIMEOUT_MS / 1000
    for attempt in range(MAX_ATTEMPTS):
        try:
            reply = connection.call_sync(
                TIMER_NAME, TIMER_PATH, TIMER_PARENT_INTERFACE, "QueryUsage",
                GLib.Variant("(uss)", (target_uid, "login-session", "")),
                GLib.VariantType.new("(a(tt))"), Gio.DBusCallFlags.NONE,
                max(1, int((deadline - monotonic()) * 1000)), None,
            )
            intervals, = reply.unpack()
            return intervals
        except GLib.Error as error:
            transient = any(error.matches(Gio.dbus_error_quark(), code) for code in (
                Gio.DBusError.NO_REPLY, Gio.DBusError.NAME_HAS_NO_OWNER,
                Gio.DBusError.SERVICE_UNKNOWN,
            ))
            if (not transient or attempt + 1 == MAX_ATTEMPTS or
                    deadline - monotonic() <= RETRY_DELAY_SECONDS):
                raise
            # Re-address the well-known name so D-Bus can activate its next owner.
            # Authorization errors and malformed replies are never retried.
            sleep(RETRY_DELAY_SECONDS)


def main() -> int:
    if os.geteuid() == 0 or len(sys.argv) != 2:
        return 64
    try:
        target_uid = int(sys.argv[1], 10)
    except ValueError:
        return 64
    if not 0 <= target_uid <= UINT32_MAX or str(target_uid) != sys.argv[1]:
        return 64

    try:
        connection = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        intervals = query_usage(connection, target_uid)
    except GLib.Error:
        return 69

    if any(
            type(start) is not int or type(end) is not int or
            not 0 <= start <= (1 << 64) - 1 or
            not 0 <= end <= (1 << 64) - 1
            for start, end in intervals):
        return 70
    try:
        sys.stdout.write(json.dumps(intervals, separators=(",", ":")))
    except (OSError, TypeError, ValueError):
        return 70
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
