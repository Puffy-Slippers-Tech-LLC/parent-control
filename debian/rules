#!/usr/bin/make -f

# Activation compares shipped bytes. Version-only ELF notes and debug paths
# must not change unchanged native helpers or their build IDs on every update.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all qa=-elfpackagemetadata
export DEB_BUILD_DEBUGPATH = /usr/src/oh-no-parent-control
# Ubuntu's dpkg-buildpackage also supplies the note directly to the linker.
unexport ELF_PACKAGE_METADATA
PACKAGE_STAGING_ROOT ?= $(CURDIR)/debian/oh-no-parent-control

%:
	dh $@

override_dh_auto_build:
	$(MAKE) check-release-version

override_dh_clean:
	dh_clean -X.venv

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	/usr/bin/python3 -B debian/check_package.py
else
	@:
endif

override_dh_auto_install:
	$(MAKE) _install-product-files DESTDIR=$(PACKAGE_STAGING_ROOT) PREFIX=/usr SYSCONFDIR=/etc

# Hash the final shipped bytes, after shebang rewriting and ELF stripping but
# before dpkg records its own checksums. The install-stage manifest is provisional.
execute_before_dh_md5sums:
	$(MAKE) _generate-package-activation-manifest DESTDIR=$(PACKAGE_STAGING_ROOT) PREFIX=/usr SYSCONFDIR=/etc

execute_after_dh_installdeb:
	/usr/bin/python3 -B packaging/render_lifecycle.py debian --staging $(PACKAGE_STAGING_ROOT)

override_dh_installsystemd:
	# Maintainer scripts own the migration stop and manifest-selected activation.
	dh_installsystemd --no-start --no-stop-on-upgrade

# Ubuntu's automatic dbgsym extraction reseeds build IDs with the package
# version. Keep linker content IDs and omit detached debug links/packages so
# unchanged runtime files stay identical between version-only updates.
override_dh_dwz:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_fixperms:
	dh_fixperms
	chmod 0640 debian/oh-no-parent-control/usr/share/applications/com.puffyslippers.OhNoParentControl.Parent.desktop
