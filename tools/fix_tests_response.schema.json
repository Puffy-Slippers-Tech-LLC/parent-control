{
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["test_fixed", "fixed", "blocked", "app_issue", "uncertain", "stalled", "diagnostic_ready", "new_issue"]},
    "summary": {"type": "string"},
    "stage_paths": {"type": "array", "items": {"type": "string"}},
    "verification_case": {"type": ["string", "null"]},
    "diagnostic_assessment": {"type": ["string", "null"], "enum": [null, "progress", "inconclusive", "unavailable"]},
    "next_issue": {
      "type": ["object", "null"],
      "properties": {
        "attempt": {"type": "string"},
        "passed_point": {"type": "string"},
        "observation": {"type": "string"},
        "failure": {"type": "string"}
      },
      "required": ["attempt", "passed_point", "observation", "failure"],
      "additionalProperties": false
    },
    "blocker": {
      "type": ["object", "null"],
      "properties": {
        "explanation": {"type": "string"},
        "question": {"type": "string"},
        "options": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["explanation", "question", "options"],
      "additionalProperties": false
    }
  },
  "required": ["status", "summary", "blocker", "stage_paths", "verification_case", "next_issue", "diagnostic_assessment"],
  "additionalProperties": false
}
