#!/usr/bin/python3 -I
import sys
from pathlib import Path

if Path(sys.argv[0]).name == "oh-no-parent-control-child":
    sys.argv.insert(1, "--child-overlay")
component = "child" if "--child-overlay" in sys.argv[1:] else "kiosk"

sys.path.insert(0, "/usr/lib/oh-no-parent-control/kiosk")
sys.path.insert(0, "/usr/lib/oh-no-parent-control")

try:
    from common.oh_no_parent_control_ui.diagnostic_events import configure_console, emit_failure, run_cli
    configure_console()
except Exception:
    sys.stderr.write("onpc.runtime startup failed\n")
    raise SystemExit(1) from None

try:
    from oh_no_parent_control_kiosk.main import main
except Exception:
    emit_failure(component, "startup")
    sys.stderr.write("onpc.runtime startup failed\n")
    raise SystemExit(1) from None

raise SystemExit(run_cli(main, failure_component=component))
