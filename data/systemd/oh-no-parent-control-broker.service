[Unit]
Description=Oh No! Parent Control request broker
Documentation=https://github.com/Puffy-Slippers-Tech-LLC/parent-control/blob/main/docs/System-Design.md
ConditionPathExists=!/var/lib/oh-no-parent-control/migration-in-progress
# The launcher keeps policy operations blocked while child trust needs reboot,
# but admits role-checked logging and export so that the outage is reportable.
Wants=fapolicyd.service
After=fapolicyd.service

[Service]
Type=dbus
BusName=com.puffyslippers.OhNoParentControl1
ExecStart=/usr/libexec/oh-no-parent-control-broker
User=root
Group=sudo
# ExtensionManager deliberately enters the selected child's identity before
# accessing that child's dconf database and live user bus. App termination uses the
# PTRACE_MODE_READ_FSCREDS-protected /proc/PID/exe link to verify executable
# identity before signalling a child-owned process. Keep only the capabilities
# required for those operations.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID CAP_SYS_PTRACE
AmbientCapabilities=CAP_SETGID CAP_SETUID
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=no
ProtectSystem=strict
StateDirectory=oh-no-parent-control
StateDirectoryMode=0700
# Pending probe generations can outlive this broker. Only their retained owner
# may settle them; stopping/restarting the broker must not recursively erase them.
RuntimeDirectory=oh-no-parent-control/probes
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LogsDirectory=oh-no-parent-control
LogsDirectoryMode=0750
ReadWritePaths=/home
ReadWritePaths=/etc/fapolicyd
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Offline dbus-run-session needs SELinux AVC monitoring over netlink. Keep
# Internet socket families excluded; policy and settings use local services.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Allow the launcher's bounded 120-second trust wait plus broker construction.
TimeoutStartSec=180
TimeoutStopSec=5
