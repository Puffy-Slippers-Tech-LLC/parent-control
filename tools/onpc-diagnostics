#!/usr/bin/python3 -IB
"""Read system diagnostics with fixed commands, no pagers, writes or command options."""

import argparse
import configparser
from contextlib import ExitStack
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError('invalid diagnostic request; use --help')


def bounded(value):
    number = int(value)
    if not 0 <= number <= 1048576:
        raise ValueError('requested limit is outside 0..1048576')
    return number


def text_value(value):
    if not value or len(value) > 512 or any(ord(c) < 32 for c in value):
        raise ValueError('invalid diagnostic value')
    return value


def unit(value):
    if not re.fullmatch(r'[A-Za-z0-9_*?@.\[\]:\\-]{1,256}', value) or value.startswith('-'):
        raise ValueError('invalid unit pattern')
    return value


def arguments(argv):
    parser = Parser(description=__doc__, allow_abbrev=False)
    commands = parser.add_subparsers(dest='action', required=True)
    systemd = commands.add_parser('systemctl', allow_abbrev=False)
    systemd.add_argument('operation', choices=('status', 'show', 'cat', 'list-units',
                                             'list-unit-files', 'is-active', 'is-enabled'))
    systemd.add_argument('units', nargs='*', type=unit)
    systemd.add_argument('--property', action='append', default=[], type=unit)
    journal = commands.add_parser('journal', allow_abbrev=False)
    journal.add_argument('--unit', action='append', default=[], type=unit)
    journal.add_argument('--lines', type=bounded, default=200)
    journal.add_argument('--since', type=text_value)
    journal.add_argument('--until', type=text_value)
    journal.add_argument('--boot', type=int)
    journal.add_argument('--kernel', action='store_true')
    journal.add_argument('--output', choices=('short-iso', 'json'), default='short-iso')
    for name in ('read', 'tail', 'list', 'stat'):
        files = commands.add_parser(name, allow_abbrev=False)
        files.add_argument('path')
        if name in ('read', 'tail'):
            files.add_argument('--bytes', type=bounded, default=16000)
        if name == 'read':
            files.add_argument('--offset', type=bounded, default=0)
    for name in ('processes', 'disks', 'mounts', 'memory', 'cpu', 'kernel', 'network',
                 'sockets', 'packages', 'sessions'):
        commands.add_parser(name, allow_abbrev=False)
    applications = commands.add_parser('applications', allow_abbrev=False,
                                       help='list one account\'s Applications folder metadata')
    applications.add_argument('uid', type=int)
    launcher = commands.add_parser('launcher', allow_abbrev=False,
                                  help='read launch metadata from one user desktop entry')
    launcher.add_argument('uid', type=int)
    launcher.add_argument('desktop_id')
    return parser.parse_args(argv)


def command(args):
    if args.action == 'systemctl':
        if args.property and args.operation != 'show':
            raise ValueError('property selection requires show')
        return ['/usr/bin/systemctl', '--no-pager', '--no-ask-password', '--full',
                *('--property=' + value for value in args.property),
                args.operation, '--', *args.units]
    if args.action == 'journal':
        result = ['/usr/bin/journalctl', '--no-pager', '--quiet', '--lines=' + str(args.lines),
                  '--output=' + args.output, *('--unit=' + value for value in args.unit)]
        for key in ('since', 'until', 'boot'):
            value = getattr(args, key)
            if value is not None:
                result.append('--' + key + '=' + str(value))
        if args.kernel:
            result.append('--dmesg')
        return result
    return {
        'processes': ['/usr/bin/ps', '-eo', 'pid,ppid,uid,stat,etime,comm'],
        'disks': ['/usr/bin/lsblk', '--json', '--output', 'NAME,TYPE,SIZE,FSTYPE,MOUNTPOINTS'],
        'mounts': ['/usr/bin/findmnt', '--json', '--output', 'TARGET,SOURCE,FSTYPE'],
        'memory': ['/usr/bin/free', '--bytes'],
        'cpu': ['/usr/bin/lscpu'],
        'kernel': ['/usr/bin/uname', '-a'],
        'network': ['/usr/sbin/ip', '-brief', 'address', 'show'],
        'sockets': ['/usr/bin/ss', '-lntup'],
        'packages': ['/usr/bin/dpkg-query', '--show', '--showformat=${binary:Package}\t${Version}\n'],
        'sessions': ['/usr/bin/loginctl', '--no-pager', '--no-ask-password', 'list-sessions'],
    }.get(args.action)


def file_parts(value):
    text_value(value)
    parts = value.split('/')
    if parts[0] or any(part in ('', '.', '..') for part in parts[1:]):
        raise ValueError('expected an absolute diagnostic path without traversal')
    path = Path(value)
    roots = ('/var/log', '/etc/systemd', '/etc/polkit-1', '/etc/apparmor.d', '/etc/fapolicyd',
             '/usr/lib/systemd', '/usr/share/polkit-1', '/run/systemd/system',
             '/var/lib/dpkg/info', '/Data/virt-manager/oh-no-parent-control-baseline-state')
    if not any(path.is_relative_to(root) for root in roots):
        raise ValueError('path is outside diagnostic storage; use ordinary readers or test-artifacts')
    return parts[1:]


def read_file(args):
    parts = file_parts(args.path)
    # Pin every component; never open symlinks, device files or blocking FIFOs.
    with ExitStack() as stack:
        def opened(name, flags, parent=None):
            fd = os.open(name, flags | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
            stack.callback(os.close, fd)
            return fd
        parent = opened('/', os.O_RDONLY | os.O_DIRECTORY)
        for part in parts[:-1]:
            parent = opened(part, os.O_RDONLY | os.O_DIRECTORY, parent)
        fd = opened(parts[-1], os.O_RDONLY | os.O_NONBLOCK, parent)
        info = os.fstat(fd)
        directory = stat.S_ISDIR(info.st_mode)
        if not directory and not (stat.S_ISREG(info.st_mode) and info.st_nlink == 1):
            raise ValueError('expected a regular singly linked file or directory')
        if args.action == 'stat':
            print(json.dumps({'bytes': info.st_size, 'mode': oct(stat.S_IMODE(info.st_mode)),
                              'kind': 'directory' if directory else 'file', 'mtime_ns': info.st_mtime_ns}))
        elif args.action == 'list' and directory:
            print(json.dumps(sorted(os.listdir(fd))))
        elif args.action in ('read', 'tail') and not directory:
            offset = max(0, info.st_size - args.bytes) if args.action == 'tail' else args.offset
            os.lseek(fd, offset, os.SEEK_SET)
            remaining = min(args.bytes, max(0, info.st_size - offset))
            while remaining:
                chunk = os.read(fd, min(65536, remaining))
                if not chunk:
                    break
                sys.stdout.buffer.write(chunk)
                remaining -= len(chunk)
        else:
            raise ValueError('operation does not match file type')


def application_parts(uid):
    if not 1000 <= uid < 2 ** 32 - 1:
        raise ValueError('expected an ordinary account UID')
    try:
        account = pwd.getpwuid(uid)
    except KeyError as error:
        raise ValueError('account does not exist') from error
    parts = account.pw_dir.split('/')
    if (account.pw_uid != uid or len(parts) != 3 or parts[:2] != ['', 'home']
            or not parts[2] or parts[2] in ('.', '..')
            or any(ord(c) < 32 for c in account.pw_dir)):
        raise ValueError('expected a direct account home under /home')
    return [*parts[1:], 'Applications']


def read_applications(uid):
    # Only metadata in this fixed directory: no arbitrary private-file reader,
    # recursion, symlink traversal, executable invocation or application input.
    parts = application_parts(uid)
    with ExitStack() as stack:
        def directory(name, parent=None):
            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                         dir_fd=parent)
            stack.callback(os.close, fd)
            return fd
        parent = directory('/')
        for part in parts:
            parent = directory(part, parent)
        entries = []
        with os.scandir(parent) as scan:
            for entry in scan:
                if len(entries) >= 4096:
                    raise ValueError('Applications folder exceeds diagnostic entry limit')
                info = entry.stat(follow_symlinks=False)
                kind = ('file' if stat.S_ISREG(info.st_mode) else
                        'directory' if stat.S_ISDIR(info.st_mode) else
                        'symlink' if stat.S_ISLNK(info.st_mode) else 'special')
                entries.append({'name': entry.name, 'kind': kind,
                                'mode': oct(stat.S_IMODE(info.st_mode)),
                                'bytes': info.st_size})
        print(json.dumps(sorted(entries, key=lambda entry: entry['name'])))


def read_launcher(uid, desktop_id):
    if (not re.fullmatch(r'[A-Za-z0-9_ .+-]{1,240}\.desktop', desktop_id)
            or desktop_id.startswith('.')):
        raise ValueError('expected one desktop filename without traversal')
    parts = [*application_parts(uid)[:-1], '.local', 'share', 'applications', desktop_id]
    with ExitStack() as stack:
        def opened(name, flags, parent=None):
            fd = os.open(name, flags | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
            stack.callback(os.close, fd)
            return fd
        parent = opened('/', os.O_RDONLY | os.O_DIRECTORY)
        for part in parts[:-1]:
            parent = opened(part, os.O_RDONLY | os.O_DIRECTORY, parent)
        fd = opened(parts[-1], os.O_RDONLY | os.O_NONBLOCK, parent)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > 65536:
            raise ValueError('expected a small regular singly linked desktop entry')
        with os.fdopen(fd, 'rb', closefd=False) as stream:
            contents = stream.read(65537)
        if len(contents) > 65536:
            raise ValueError('desktop entry exceeds diagnostic limit')
        entry = configparser.ConfigParser(interpolation=None)
        try:
            entry.read_string(contents.decode('utf-8'))
            desktop = entry['Desktop Entry']
        except (UnicodeError, configparser.Error, KeyError) as error:
            raise ValueError('invalid desktop entry') from error
        keys = ('Type', 'Exec', 'TryExec', 'Path', 'X-AppImage-Version',
                'X-AppImage-Name', 'X-AppImage-Arch', 'X-AppImageLauncher-Version')
        print(json.dumps({key: desktop[key] for key in keys if key in desktop}))


def main(argv=None):
    try:
        args = arguments(sys.argv[1:] if argv is None else argv)
        if args.action == 'applications':
            read_applications(args.uid)
            return 0
        if args.action == 'launcher':
            read_launcher(args.uid, args.desktop_id)
            return 0
        selected = command(args)
        if selected is None:
            read_file(args)
            return 0
        env = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8',
               'SYSTEMD_PAGER': '', 'SYSTEMD_COLORS': '0', 'PAGER': '/bin/cat',
               'SYSTEMD_PAGERSECURE': '1'}
        return subprocess.run(selected, env=env, stdin=subprocess.DEVNULL,
                              timeout=60, check=False).returncode
    except (ValueError, OSError, subprocess.TimeoutExpired):
        print('diagnostics: invalid request, inaccessible source, or command failure; use --help', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
