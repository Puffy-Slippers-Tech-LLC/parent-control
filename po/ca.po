msgstr "Cada adjunt ha de tenir 5 MB o menys."

#. Shared message: ATTACHMENTS_AND_DIAGNOSTIC_LOGS_MUST_TOTAL_8_MB_OR_LESS
msgid "Attachments and diagnostic logs must total 8 MB or less."
msgstr "Els adjunts i els registres de diagnòstic han de sumar 8 MB o menys."

