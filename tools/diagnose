#!/usr/bin/python3 -IB
"""Use the installed, read-only system diagnostic helper."""
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from dev_privileges import launch

if __name__ == '__main__':
    try:
        launch('/usr/local/libexec/onpc-diagnostics', sys.argv[1:])
    except (ValueError, OSError) as error:
        sys.exit('diagnose: ' + (str(error) if isinstance(error, ValueError) else 'refresh test tools with setup'))
