# Machine-wide read-only commands. Shell pipelines are checked one stage at a
# time, so the reader/fetcher and every output filter need their own allow rule.
prefix_rule(pattern=["cat"], decision="allow", justification="Reading files is allowed without approval")
prefix_rule(pattern=["ls"], decision="allow", justification="Listing files is allowed without approval")
prefix_rule(pattern=["sed", "-n"], decision="allow", justification="Printing selected file content is allowed without approval")
prefix_rule(pattern=["tail"], decision="allow", justification="Reading the end of files and logs is allowed without approval")
prefix_rule(pattern=["systemctl", "cat"], decision="allow", justification="Reading systemd unit definitions is allowed without approval")
prefix_rule(pattern=["systemctl", "show"], decision="allow", justification="Reading systemd unit properties is allowed without approval")
prefix_rule(pattern=["systemctl", "status"], decision="allow", justification="Reading systemd unit status is allowed without approval")
prefix_rule(pattern=["rg"], decision="allow", justification="Searching text is read-only and allowed without approval")
prefix_rule(pattern=["grep"], decision="allow", justification="Searching text is read-only and allowed without approval")
prefix_rule(pattern=["jq"], decision="allow", justification="Filtering JSON text is read-only and allowed without approval")
prefix_rule(pattern=["cut"], decision="allow", justification="Selecting text fields is read-only and allowed without approval")
prefix_rule(pattern=["sort"], decision="allow", justification="Sorting text is read-only and allowed without approval")
prefix_rule(pattern=["uniq"], decision="allow", justification="Filtering repeated text is read-only and allowed without approval")
prefix_rule(pattern=["wc"], decision="allow", justification="Counting text is read-only and allowed without approval")
prefix_rule(pattern=["curl", "-fsSL"], decision="allow", justification="Fetching public research to standard output is allowed without approval")
prefix_rule(pattern=["wget", "-qO-"], decision="allow", justification="Fetching public research to standard output is allowed without approval")
prefix_rule(pattern=["wget", "-qO", "-"], decision="allow", justification="Fetching public research to standard output is allowed without approval")
prefix_rule(pattern=["wget", "-O", "-"], decision="allow", justification="Fetching public research to standard output is allowed without approval")
