Requires:       gstreamer1
Requires:       gstreamer1-plugins-base
Requires:       gstreamer1-plugins-good
Requires:       gtk4
Requires:       hicolor-icon-theme
Requires:       libadwaita
Requires:       malcontent >= 0.14.0
Requires:       malcontent-libs >= 0.14.0
Requires:       malcontent-pam >= 0.14.0
Requires:       mate-polkit
Requires:       polkit
Requires:       python3-gobject
Requires:       python3-cairo
Requires:       python3-requests
Requires:       policycoreutils
Requires:       shadow-utils
Requires:       systemd
Requires:       util-linux
Requires:       webkitgtk6.0
Requires(pretrans): dnf5
Requires(pretrans): python3
Requires(pretrans): rpm
Requires(pretrans): systemd
Requires(pre):  authselect
Requires(pre):  coreutils
Requires(pre):  glibc-common
Requires(pre):  systemd
Requires(preun): authselect
Requires(preun): coreutils
Requires(preun): findutils
Requires(preun): python3
Requires(preun): systemd
Requires(preun): util-linux
