#. Shared message: ONE_OR_MORE_ATTACHMENTS_ARE_INVALID
msgid "One or more attachments are invalid."
msgstr "ഒന്നോ അതിലധികമോ അറ്റാച്ച്മെന്റുകൾ അസാധുവാണ്."

#. Shared message: EACH_ATTACHMENT_MUST_BE_5_MB_OR_SMALLER
msgid "Each attachment must be 5 MB or smaller."
msgstr "ഓരോ അറ്റാച്ച്മെന്റും 5 MB അല്ലെങ്കിൽ അതിലും ചെറുതായിരിക്കണം."

#. Shared message: ATTACHMENTS_AND_DIAGNOSTIC_LOGS_MUST_TOTAL_8_MB_OR_LESS
msgid "Attachments and diagnostic logs must total 8 MB or less."
msgstr "അറ്റാച്ച്മെന്റുകളും പ്രശ്നനിർണയ ലോഗുകളും ചേർന്ന് പരമാവധി 8 MB ആയിരിക്കണം."

