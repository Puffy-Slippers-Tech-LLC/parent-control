#!/bin/bash
set -euo pipefail

readonly CHECKOUT=/Data/Code/PST/parent-control
readonly PREPARER="$CHECKOUT/tests/integration/prepare_vm.py"

if (( $# != 0 )); then
    echo 'prep-vm: no arguments are accepted' >&2
    exit 2
fi

if [[ "$PWD" != "$CHECKOUT" ]]; then
    echo 'prep-vm: [guard:checkout] run from the fixed source-VM checkout' >&2
    exit 1
fi

if (( EUID != 0 )); then
    echo 'prep-vm: [stage:sudo] requesting root privileges for source-VM preparation' >&2
    exec sudo -- /usr/bin/python3 "$PREPARER"
fi

exec /usr/bin/python3 "$PREPARER"
