#!/usr/bin/python3 -IB
"""Root-owned dispatcher for fixed setup operations in the trusted checkout."""
import os
from pathlib import Path
import subprocess
import sys

CHECKOUT = None  # Replaced with the runtime resolver by install_test_runner.py.
OPERATIONS = {
    'dependencies': ('tools/setup_dependencies.sh',),
    'ppa-build-tools': ('tools/setup_dependencies.sh', '--ppa-build-tools'),
    'rpm-build-tools': ('tools/setup_dependencies.sh', '--rpm-build-tools'),
    'codex-rules': ('tools/install_codex_rules.py', '--system'),
    'test-tools': ('tools/install_test_runner.py',),
    'graphical-policy': ('tools/install_graphical_test_policy.py',),
    'prepare-baseline': ('tests/integration/prepare_baseline.py',),
    'replace-missing-baseline': ('tests/integration/prepare_baseline.py', '--replace-missing'),
    'backupvms': ('tools/vm_backup.py', 'backup'),
    'restorevms': ('tools/vm_backup.py', 'restore'),
}


def command(root, argv):
    mode_args = []
    vm_args = []
    recovery = bool(argv and argv[0] in ('backupvms', 'restorevms'))
    if recovery:
        sys.path.insert(0, str(root / 'tests/integration'))
        try:
            import vm_config
            remaining, selector = vm_config.extract_selector(argv)
            if len(remaining) != 1:
                raise ValueError('setup-helper: VM recovery accepts only --vm')
            _, vms = vm_config.execution(selector if selector is not None else 'all',
                                        path=root / 'config/test-vm.json')
            vm_config.backup_root(root / 'config/test-vm.json')
            argv = remaining
            vm_args = ['--vm', ','.join(vm.name for vm in vms)]
        finally:
            sys.path.pop(0)
    if argv and argv[0] in ('prepare-baseline', 'replace-missing-baseline'):
        sys.path.insert(0, str(root / 'tests/integration'))
        try:
            import vm_config
        finally:
            sys.path.pop(0)
        argv, configured = vm_config.extract(argv, path=root / 'config/test-vm.json')
        vm_args = ['--vm', configured.name]
    if argv and argv[0] == 'prepare-baseline':
        if (len(argv) not in (3, 4) or argv[1] != '--mode'
                or argv[2] not in ('auto', 'manual')
                or (len(argv) == 4 and argv[3] != '--y')):
            raise ValueError('setup-helper: prepare-baseline requires --mode auto or --mode manual with optional --y')
        mode_args = argv[1:]
    elif len(argv) != 1 or argv[0] not in OPERATIONS:
        raise ValueError('setup-helper: expected one supported setup operation')
    relative, *args = OPERATIONS[argv[0]]
    args.extend(mode_args)
    args.extend(vm_args)
    target = root / relative
    if not root.is_absolute() or any(path.is_symlink() for path in (target, *target.parents)):
        raise ValueError('setup-helper: unsafe checkout path')
    if not target.is_file():
        raise ValueError('setup-helper: missing setup module')
    if argv[0] in ('dependencies', 'ppa-build-tools', 'rpm-build-tools'):
        return ['/bin/bash', str(target), *args]
    # prepare_baseline imports its sibling guest contract; the other installers use
    # only the standard library and can run with Python's isolated mode.
    return ['/usr/bin/python3', '-B' if recovery or argv[0] in ('prepare-baseline', 'replace-missing-baseline') else '-IB', str(target), *args]


def main():
    try:
        if CHECKOUT is None or os.geteuid() != 0 or int(os.environ.get('PKEXEC_UID', '0')) <= 0:
            raise ValueError('setup-helper: use the installed helper through setup.sh')
        root = Path(CHECKOUT)
        selected = command(root, sys.argv[1:])
        report_status = sys.argv[1] != 'prepare-baseline'
        if report_status:
            print(f'setup-helper: starting {sys.argv[1]}', flush=True)
        result = subprocess.run(selected, cwd=root, check=False,
                                env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin',
                                     'LANG': 'C.UTF-8', 'HOME': '/root',
                                     'PKEXEC_UID': str(int(os.environ['PKEXEC_UID'])),
                                     'DEBIAN_FRONTEND': 'noninteractive',
                                     'PYTHONDONTWRITEBYTECODE': '1'})
        if report_status:
            print(f'setup-helper: finished (status={result.returncode})', flush=True)
        return result.returncode
    except (ValueError, OSError) as error:
        print(str(error) if isinstance(error, ValueError) else 'setup-helper: filesystem or execution failure',
              file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
