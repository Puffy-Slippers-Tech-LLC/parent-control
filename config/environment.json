{
  "agent": "codex",
  "snap_tests_enabled": false,
  "hosts": [
    {
      "name": "local",
      "enabled": "true",
      "transport": "local",
      "virt-manager": "/Data/virt-manager",
      "max_compute_unit": 3,
      "disk_concurrency": 1,
      "backup_root": "/Data/virt-manager/backups/onpc"
    },
    {
      "name": "myserver",
      "enabled": "true",
      "transport": "ssh",
      "virt-manager": "/Data/virt-manager",
      "ssh_port": 22,
      "backup_root": "/Data/virt-manager/backups/onpc",
      "max_compute_unit": 6,
      "disk_concurrency": 2
    }
  ],
  "branches": [
    {
      "name": "main",
      "host": "local",
      "repo_root": "/Data/Code/PST/parent-control"
    },
    {
      "name": "worktree",
      "host": "local",
      "repo_root": "/Data/Code/PST/parent-control1"
    },
    {
      "name": "test",
      "host": "myserver",
      "repo_root": "/Data/Code/PST/parent-control-test"
    },
    {
      "name": "others",
      "host": "myserver",
      "repo_root": "/Data/Code/PST/parent-control-others"
    }
  ],
  "launchers": [
    {
      "name": "fix-tests",
      "default_branch": "main"
    },
    {
      "name": "run-tests",
      "default_branch": "main"
    },
    {
      "name": "write-e2e",
      "default_branch": "worktree"
    }
  ],
