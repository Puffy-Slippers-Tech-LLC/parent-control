#. Shared message: DAILY_ALLOWANCE_REMAINING_B_DAILY_S_B_ONE_TIME_GRANT_REMAINING_B
#. Preserve named operands and any markup; operands are supplied by the owning UI.
#, python-format
msgid "Daily allowance remaining: <b>%(daily)s</b>\nOne-time grant remaining: <b>%(grant)s</b>\n<b>Remaining time: %(remaining)s</b> — the larger of the two amounts."
msgstr "ദിവസേന അനുവദിച്ച സമയത്തിൽ ബാക്കി: <b>%(daily)s</b>\nഒറ്റത്തവണ അനുമതിയിൽ ബാക്കി: <b>%(grant)s</b>\n<b>ബാക്കിയുള്ള സമയം: %(remaining)s</b> — രണ്ടിൽ വലിയ അളവ്."

#. Shared message: ALWAYS_ALLOWED
msgid "Always Allowed"
msgstr "എപ്പോഴും അനുവദിച്ചത്"

#. Shared message: HARD_BLOCKED
msgid "Hard Blocked"
msgstr "പൂർണമായി തടഞ്ഞത്"

#. Shared message: SOFT_BLOCKED
msgid "Soft Blocked"
msgstr "താൽക്കാലിക അനുമതി നൽകാവുന്ന തടയൽ"

#. Shared message: PATTERN_MATCH
msgid "Pattern Match"
msgstr "മാതൃക അനുസരിച്ചുള്ള പൊരുത്തം"

#. Shared message: MATCHES_VERSIONED_FILENAMES_USING_A_WILDCARD
msgid "Matches versioned filenames using a wildcard."
msgstr "വൈൽഡ്‌കാർഡ് ഉപയോഗിച്ച് പതിപ്പുള്ള ഫയൽപേരുകൾ പൊരുത്തപ്പെടുത്തുന്നു."

#. Shared message: PRECISE_EXECUTION_PATH
msgid "Precise execution path"
msgstr "പ്രവർത്തിപ്പിക്കുന്ന കൃത്യമായ പാത"

#. Shared message: MATCHES_ONLY_THIS_EXACT_EXECUTABLE_PATH
msgid "Matches only this exact executable path."
msgstr "ഈ പ്രവർത്തിപ്പിക്കാവുന്ന ഫയലിന്റെ കൃത്യമായ പാതയുമായി മാത്രം പൊരുത്തപ്പെടുന്നു."

#. Shared message: SOME_APP_LIMITS_COULD_NOT_BE_APPLIED_AFFECTED_APPS_OR_UPDATED_VE
msgid "Some app limits could not be applied. Affected apps or updated versions may be unrestricted. Other controls remain available, and saved rules will be retried automatically."
msgstr "ചില ആപ്പ് നിയന്ത്രണങ്ങൾ പ്രയോഗിക്കാനായില്ല. ബാധിച്ച ആപ്പുകൾക്കോ പുതുക്കിയ പതിപ്പുകൾക്കോ നിയന്ത്രണങ്ങൾ ഇല്ലാതിരിക്കാം. മറ്റു നിയന്ത്രണങ്ങൾ ലഭ്യമാണ്; സൂക്ഷിച്ച നിയമങ്ങൾ പ്രയോഗിക്കാൻ സ്വയം വീണ്ടും ശ്രമിക്കും."

#. Shared message: SELECTED_CHILD_LABEL_S
#. Preserve named operands and any markup; operands are supplied by the owning UI.
#, python-format
