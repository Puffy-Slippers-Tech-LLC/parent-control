#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
PACKAGE_STAGING_ROOT ?= $(CURDIR)/debian/oh-no-parent-control

%:
	dh $@

override_dh_auto_build:
	$(MAKE) check-release-version

override_dh_clean:
	dh_clean -X.venv

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	/usr/bin/python3 -B debian/check_package.py
else
	@:
endif

override_dh_auto_install:
	$(MAKE) _install-product-files DESTDIR=$(PACKAGE_STAGING_ROOT) PREFIX=/usr SYSCONFDIR=/etc

# Hash the final shipped bytes, after shebang rewriting and ELF stripping but
# before dpkg records its own checksums. The install-stage manifest is provisional.
execute_before_dh_md5sums:
	$(MAKE) _generate-package-activation-manifest DESTDIR=$(PACKAGE_STAGING_ROOT) PREFIX=/usr SYSCONFDIR=/etc

override_dh_installsystemd:
	# Maintainer scripts own the migration stop and manifest-selected activation.
	dh_installsystemd --no-start --no-stop-on-upgrade

override_dh_fixperms:
	dh_fixperms
	chmod 0640 debian/oh-no-parent-control/usr/share/applications/com.puffyslippers.OhNoParentControl.Parent.desktop
