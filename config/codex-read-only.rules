# Machine-wide inspection, independent of checkout and path. Select any repo
# with the command tool's working directory; no unrestricted git/-C prefix.
# These ordinary reads were previously dependent on saved personal approvals.
# Prefix grants trust trailing arguments; use tools/read-only for untrusted input.
prefix_rule(
    pattern = [["cat", "ls", "head", "tail", "cut", "sort", "uniq", "wc", "jq", "sha256sum",
                "/usr/bin/cat", "/usr/bin/ls", "/usr/bin/head", "/usr/bin/tail",
                "/usr/bin/cut", "/usr/bin/sort", "/usr/bin/uniq", "/usr/bin/wc",
                "/usr/bin/jq", "/usr/bin/sha256sum"]],
    decision = "allow",
    justification = "Reproduce authorized ordinary file reads, filters and checksums on development hosts.",
)
prefix_rule(
    pattern = [["curl", "/usr/bin/curl"], "-fsSL"],
    decision = "allow",
    justification = "Fetch trusted public research to standard output with a direct quoted URL.",
)
prefix_rule(
    pattern = [["sed", "/usr/bin/sed"], "-n"],
    decision = "allow",
    justification = "User-authorized file slices across any system path or repository.",
    match = ["sed -n '1,95p' tests/integration/check_graphical_smoke.py", "/usr/bin/sed -n '20,80p' /var/log/example.log"],
    not_match = ["sed -i s/old/new/ file", "bash -c 'sed -n 1p file'"],
)
prefix_rule(
    pattern = [["rg", "/usr/bin/rg"], ["-n", "--files"]],
    decision = "allow",
    justification = "User-authorized text searches and file discovery across any system path or repository.",
    # These examples check argv prefixes, not Codex's shell parser. Unquoted
    # filename globs keep the enclosing shell opaque to this rule. Use quoted
    # --glob filters and literal roots; never add a shell grant to cover them.
    match = [
        "rg -n needle /etc /tmp",
        "rg -n 'setup|install' setup.sh tools",
        "/usr/bin/rg -n needle /var/log",
        "rg --files output/test-runs/host/reports --glob 'category-*.log'",
        "/usr/bin/rg --files --hidden --glob '*.py' /tmp/another-checkout",
        "rg -n '^(def|class) |environment|provenance|accepted' --glob '/tools/*baseline*' --glob '/tools/*baseline*/**' --glob '/tests/integration/baseline*' --glob '/tests/integration/baseline*/**' .",
    ],
    not_match = ["rg --pre /tmp/program needle", "bash -c 'rg -n needle'"],
)
prefix_rule(
    pattern = [["pwd", "/bin/pwd", "/usr/bin/pwd"]],
    decision = "allow",
    justification = "Read the working directory anywhere on this machine.",
    match = ["pwd", "/usr/bin/pwd -P"],
    not_match = ["bash -c pwd"],
)
prefix_rule(
    pattern = [["git", "/usr/bin/git"], "status"],
    decision = "allow",
    justification = "Inspect Git status and path selections in any repository working directory.",
    match = ["git status --short", "git status --porcelain=v1 --untracked-files=all -- any/path", "/usr/bin/git status"],
    not_match = ["git reset --hard", "git config --global user.name example", "git -C /tmp/repo status"],
)
