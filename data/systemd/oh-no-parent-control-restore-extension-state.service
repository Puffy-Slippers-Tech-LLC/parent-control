[Unit]
Description=Restore GNOME extension state after Parent Control installation
Documentation=https://github.com/Puffy-Slippers-Tech-LLC/parent-control/blob/main/docs/Package-Update.md
ConditionPathExists=/var/lib/oh-no-parent-control/extension-state-restore.json
After=local-fs.target
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/oh-no-parent-control-preserve-extension-state --restore

[Install]
WantedBy=multi-user.target
