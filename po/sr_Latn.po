msgstr "Priloge nije bilo moguće odabrati. Pokušajte ponovo."

#. Shared message: COULD_NOT_READ_ONE_OR_MORE_ATTACHMENTS_TRY_DIFFERENT_FILES
msgid "Could not read one or more attachments. Try different files."
msgstr "Jedan ili više priloga nije bilo moguće pročitati. Pokušajte s drugim datotekama."

#. Shared message: COULD_NOT_CHOOSE_A_DOWNLOAD_LOCATION_TRY_AGAIN
msgid "Could not choose a download location. Try again."
msgstr "Mesto preuzimanja nije bilo moguće odabrati. Pokušajte ponovo."

#. Shared message: SOMETHING_WENT_WRONG
msgid "Something went wrong"
msgstr "Nešto je pošlo po zlu"

#. Shared message: THE_OPERATION_COULD_NOT_BE_COMPLETED_PLEASE_TRY_AGAIN_LATER
msgid "The operation could not be completed. Please try again later."
msgstr "Radnju nije bilo moguće dovršiti. Pokušajte ponovo kasnije."

#. Shared message: ERROR_REPORT_UNAVAILABLE
msgid "Error report unavailable"
msgstr "Izveštaj o grešci nije dostupan"

#. Shared message: THE_FEEDBACK_DIALOG_COULD_NOT_BE_OPENED_PLEASE_TRY_AGAIN_LATER
msgid "The feedback dialog could not be opened. Please try again later."
msgstr "Dijalog povratnih informacija nije bilo moguće otvoriti. Pokušajte ponovo kasnije."

#. Shared message: CLOSE_THE_ERROR_REPORT_NOTICE
msgid "Close the error report notice."
msgstr "Zatvorite obaveštenje o izveštaju o grešci."

#. Shared message: FEEDBACK_REPLY_EMAIL_ADDRESSES_ATTACHMENTS_AND_DIAGNOSTIC_LOGS_A
msgid "Feedback, reply email addresses, attachments, and diagnostic logs are emailed to support. Retention depends on our support mailbox and service providers, including their backup policies. We do not currently guarantee deletion within a fixed period."
msgstr "Povratne informacije, adrese e-pošte za odgovor, prilozi i dijagnostički zapisi šalju se e-poštom podršci. Čuvanje zavisi od našeg poštanskog sandučeta podrške i pružalaca usluga, uključujući njihova pravila pravljenja rezervnih kopija. Trenutno ne garantujemo brisanje u određenom roku."

#. Shared message: ENTER_A_SINGLE_LINE_FEEDBACK_TITLE_OF_AT_MOST_200_CHARACTERS
msgid "Enter a single-line feedback title of at most 200 characters."
msgstr "Unesite naslov povratnih informacija u jednom redu s najviše 200 znakova."

#. Shared message: PLEASE_ENTER_YOUR_FEEDBACK
msgid "Please enter your feedback."
msgstr "Unesite svoje povratne informacije."

#. Shared message: YOUR_FEEDBACK_CONTAINS_AN_UNSUPPORTED_HIDDEN_CHARACTER_PLEASE_RE
msgid "Your feedback contains an unsupported hidden character. Please retype it and try again."
msgstr "Vaše povratne informacije sadrže nepodržani skriveni znak. Ponovo ih upišite i pokušajte ponovo."

#. Shared message: FEEDBACK_MUST_BE_AT_MOST_5_000_UTF_16_CHARACTERS_SOME_EMOJI_COUN
msgid "Feedback must be at most 5,000 UTF-16 characters (some emoji count as two)."
msgstr "Povratne informacije mogu imati najviše 5 000 znakova UTF-16 (neki emodžiji računaju se kao dva)."

#. Shared message: THE_FORMATTED_FEEDBACK_IS_TOO_COMPLEX_REMOVE_SOME_FORMATTING_AND
msgid "The formatted feedback is too complex. Remove some formatting and try again."
msgstr "Formatirane povratne informacije previše su složene. Uklonite deo formatiranja i pokušajte ponovo."

#. Shared message: ENTER_A_BARE_REPLY_EMAIL_ADDRESS_OR_LEAVE_IT_BLANK
msgid "Enter a bare reply email address, or leave it blank."
msgstr "Unesite samo adresu e-pošte za odgovor ili ostavite prazno."

#. Shared message: THE_APP_VERSION_IS_INVALID_PLEASE_UPDATE_THE_APPLICATION
msgid "The app version is invalid. Please update the application."
msgstr "Verzija aplikacije nije važeća. Ažurirajte aplikaciju."

