#!/bin/bash
set -euo pipefail

CHECKOUT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
readonly CHECKOUT
readonly PREPARER="$CHECKOUT/tests/integration/prepare_vm.py"

if (( $# != 0 )); then
    echo 'prepare-vm: no arguments are accepted' >&2
    exit 2
fi

if [[ "$(pwd -P)" != "$CHECKOUT" ]]; then
    echo 'prepare-vm: [guard:checkout] run from this checkout root inside the configured VM' >&2
    exit 1
fi

if (( EUID != 0 )); then
    echo 'prepare-vm: [stage:sudo] requesting root privileges for source-VM preparation' >&2
    exec sudo -- /usr/bin/python3 -B "$PREPARER"
fi

exec /usr/bin/python3 -B "$PREPARER"
