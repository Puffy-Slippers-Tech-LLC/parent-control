[Unit]
Description=Oh No! Parent Control request broker
Documentation=https://github.com/Puffy-Slippers-Tech-LLC/parent-control/blob/main/docs/System-Design.md
ConditionPathExists=!/var/lib/oh-no-parent-control/migration-in-progress
Wants=fapolicyd.service
After=fapolicyd.service

[Service]
Type=dbus
BusName=com.puffyslippers.OhNoParentControl1
ExecStart=/usr/libexec/oh-no-parent-control-broker
User=root
Group=sudo
# ExtensionManager deliberately enters the selected child's identity before
# accessing that child's dconf database and live user bus. App termination uses the
# PTRACE_MODE_READ_FSCREDS-protected /proc/PID/exe link to verify executable
# identity before signalling a child-owned process. Keep only the capabilities
# required for those operations.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID CAP_SYS_PTRACE
AmbientCapabilities=CAP_SETGID CAP_SETUID
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=no
ProtectSystem=strict
StateDirectory=oh-no-parent-control
StateDirectoryMode=0700
LogsDirectory=oh-no-parent-control
LogsDirectoryMode=0750
ReadWritePaths=/home
ReadWritePaths=/etc/fapolicyd
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
TimeoutStopSec=5
