#!/usr/bin/python3
import sys
import subprocess
from pathlib import Path

if Path("/var/lib/oh-no-parent-control/migration-in-progress").exists():
    raise SystemExit("onpc.service: saved-data migration is incomplete")
diagnostics_only = Path("/run/oh-no-parent-control-child-trust-reboot").exists()

# Check trust even when systemd's Wants dependency failed, or this launcher is
# invoked directly. The boot-scoped guard alone cannot establish readiness.
# The service also checks package reboot requests after this import-safety gate
# and retains only diagnostics and role-checked kiosk presentation reads.
if not diagnostics_only:
    try:
        subprocess.run(
            ["/usr/libexec/oh-no-parent-control-package-activation", "wait-child-trust"],
            stdin=subprocess.DEVNULL, check=True, timeout=125,
        )
    except (OSError, subprocess.SubprocessError):
        raise SystemExit("onpc.service: child trust database is not ready") from None

sys.path.insert(0, "/usr/lib/oh-no-parent-control/broker")
sys.path.insert(0, "/usr/lib/oh-no-parent-control")

try:
    from common.oh_no_parent_control_ui.diagnostic_events import configure_console, run_cli
    configure_console()
    from oh_no_parent_control.service import main
except Exception:
    sys.stderr.write("onpc.runtime startup failed\n")
    raise SystemExit(1) from None

raise SystemExit(run_cli(lambda: main(diagnostics_only=diagnostics_only)))
