#!/usr/bin/python3 -I
"""Fixed-purpose kiosk PAM service and selected-session checks."""

import os
import pwd
import shlex
import subprocess
import sys
import syslog

KIOSK_USER = "oh-no-parent-control"
SESSION = "oh-no-parent-control"
PENDING_SESSION = "oh-no-parent-control-verification-pending"
BUS = "org.freedesktop.Accounts"
INTERFACE = "org.freedesktop.Accounts.User"
ENVIRONMENT = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}


def busctl(*arguments):
    return subprocess.run(
        ["/usr/bin/busctl", "--system", "--timeout=4",
         "--allow-interactive-authorization=no", *arguments],
        check=True, capture_output=True, text=True, timeout=5,
        env=ENVIRONMENT,
    ).stdout


def read_session(path):
    values = shlex.split(busctl("get-property", BUS, path, INTERFACE,
                               "Session", "SessionType"))
    if len(values) != 4 or values[0] != "s" or values[2] != "s":
        raise ValueError("invalid session properties")
    return values[1], values[3]


def category(value, expected):
    return "dedicated" if value == expected else "other" if value else "unset"


def record(stage, outcome, session="unknown", session_type="unknown", recovery="none", reason="none"):
    # Every argument is a closed category chosen here, never an OS value.
    syslog.syslog(
        syslog.LOG_INFO if outcome in ("allowed", "armed") else syslog.LOG_WARNING,
        f"onpc.pam kiosk routing stage={stage} outcome={outcome} "
        f"session={session} type={session_type} recovery={recovery} reason={reason}",
    )


def failure_reason(error):
    if isinstance(error, subprocess.TimeoutExpired):
        return "timeout"
    if isinstance(error, subprocess.CalledProcessError):
        return "bus-failed"
    if isinstance(error, KeyError):
        return "identity"
    if isinstance(error, ValueError):
        return "verification"
    return "unavailable"


def verify_session(stage):
    """GDM 50 saves the selected Session before invoking pam_open_session.

    The native PAM module serializes account -> save -> open-session; this
    helper must only run inside that transaction. GDMSESSION is not available
    at this point and an installation-time default is not an admission check.
    """
    try:
        account = pwd.getpwnam(KIOSK_USER)
        if account.pw_uid == 0:
            raise ValueError("invalid station identity")
        path = f"/org/freedesktop/Accounts/User{account.pw_uid}"
        session, saved_type = read_session(path)
    except (KeyError, OSError, ValueError, subprocess.SubprocessError) as error:
        record(stage, "unavailable", reason=failure_reason(error))
        return 1

    session_category = category(session, SESSION)
    # The PAM environment carries the actual transport at open-session.
    actual_type = os.environ.get("XDG_SESSION_TYPE", "") if stage == "session" else saved_type
    type_category = "wayland" if actual_type == "wayland" else "other" if actual_type else "unset"
    if session == SESSION and actual_type == "wayland":
        if stage == "account":
            # Invalidate the persisted preference after GDM has loaded it.
            # GDM's best-effort save must replace this marker before open.
            # Otherwise a failed save could leave an old valid default and
            # falsely attest to a different session selected in the greeter.
            try:
                busctl("call", BUS, path, INTERFACE, "SetSession", "s", PENDING_SESSION)
                if read_session(path) != (PENDING_SESSION, "wayland"):
                    raise ValueError("session verification was not armed")
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                record(stage, "unavailable", session_category, type_category,
                       reason=failure_reason(error))
                return 1
            record(stage, "armed", session_category, type_category)
            return 0
        record(stage, "allowed", session_category, type_category)
        return 0

    # A refused selection must not poison the station's next default. Restore
    # through the public service, then still deny this attempt; never treat a
    # repaired preference as proof of what this GDM worker selected.
    recovery = "failed"
    try:
        busctl("call", BUS, path, INTERFACE, "SetSession", "s", SESSION)
        busctl("call", BUS, path, INTERFACE, "SetSessionType", "s", "wayland")
        if read_session(path) == (SESSION, "wayland"):
            recovery = "restored"
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    record(stage, "denied", session_category, type_category, recovery)
    return 1


def main(arguments=None):
    arguments = sys.argv[1:] if arguments is None else arguments
    user = os.environ.get("PAM_USER", "")
    service = os.environ.get("PAM_SERVICE", "")
    if arguments not in ([], ["--kiosk-account"], ["--kiosk-session"]):
        return 1
    if user != KIOSK_USER:
        return 0 if not arguments else 1
    if service == "systemd-user":
        return 0 if not arguments else 1
    if service != "gdm-password":
        record("service", "denied")
        return 1
    if not arguments:
        return 0
    if os.geteuid() != 0:
        record("service", "denied")
        return 1
    return verify_session("account" if arguments == ["--kiosk-account"] else "session")


if __name__ == "__main__":
    sys.exit(main())
