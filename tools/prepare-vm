#!/usr/bin/python3 -IB
"""Prepare baseline and current app snapshots, then restore the powered-off baseline."""
import argparse
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tests/integration'))
sys.path.insert(0, str(Path(__file__).resolve().parent))
import test_source
with test_source.startup(ROOT, sys.argv[1:]):
    from test_account_password import read_password
    from dev_privileges import check
    from baseline_messages import help_message, mode_message
    from vm_selection import select, vm_config, SELECTOR_HELP
    from vm_pool import reservation, arguments as checkout_arguments
    from vm_queue import preparation
    import test_activity

HELPER = '/usr/local/libexec/onpc-setup'


def outcome(status, message):
    color = '31' if status else '32'
    print(f'\033[{color}mprepare-vm: {message}\033[0m',
          file=sys.stderr if status else sys.stdout, flush=True)
    return status


def arguments(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--mode', required=True, choices=('auto', 'manual'),
                        help='auto: restore baseline and update guest; manual: prepare current VM state')
    parser.add_argument('--vm', default='all',
                        help=SELECTOR_HELP.replace('all-enabled (default)', 'all-enabled').replace(
                            'or all;', 'or all (default);'))
    parser.add_argument('--y', action='store_true',
                        help='proceed without y/n confirmation; use for authorized launcher/session work')
    parser.epilog = help_message()
    # Show the complete, short usage reminder for missing options or values.
    def error(message):
        parser.print_help(sys.stderr)
        parser.exit(2, '\033[31m\nPlease choose --mode auto or --mode manual. ' + message + '\033[0m\n')
    parser.error = error
    return parser.parse_args(argv)


def main(argv=None, *, refresh=True, _worker=False):
    args = arguments(argv)
    try:
        concurrency, vms = vm_config.execution(args.vm)
        from vm_pool import check_queue
        check_queue(vms)
        args.vm = ','.join(vm.name for vm in vms)
        if os.geteuid() == 0:
            raise ValueError('invoke as an unprivileged administrator')
        read_password()
        check(HELPER)
        test_source.finish_admission()
        if not _worker:
            from vm_selection import confirm_queue
            if not confirm_queue(args, 'prepare-vm', mode_message(args.mode)):
                print('prepare-vm: cancelled; no baseline snapshot was prepared.')
                return 0
            results, queue_status = preparation(ROOT, 'prepare-vm', args, concurrency, vms)
            # Even after a partial failure, accept successfully prepared VMs.
            status = 0
            if refresh and 0 in results.values():
                with test_source.reader(ROOT):
                    status = subprocess.run([str(ROOT / 'setup.sh'), '--test-tools-only'], cwd=ROOT,
                                            pass_fds=test_source.descriptors()).returncode
            status = status or queue_status
            return outcome(status, 'preparation failed; inspect the reported errors.' if status else
                           f'onpc_baseline prepared and accepted for {args.vm}.')
        select(args.vm)
        with reservation(args.vm), test_activity.activity(ROOT, named_vm=True), test_source.reader(ROOT):
            status = subprocess.run(
                ['/usr/bin/pkexec', '--keep-cwd', HELPER, *checkout_arguments(),
                 'prepare-vm', '--mode', args.mode,
                 *(['--y'] if args.y else []), '--vm', args.vm],
                cwd=ROOT,
                env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'},
                pass_fds=test_source.descriptors(),
            ).returncode
        if status == 3:  # Operator declined; no baseline was prepared.
            print('prepare-vm: cancelled; no baseline snapshot was prepared.')
            return 0
        if status:
            return outcome(status, 'preparation failed; inspect the reported errors.')
        if not refresh:
            return 0
        # Pin the accepted UUID only after successful baseline reconciliation.
        with test_source.reader(ROOT):
            status = subprocess.run([str(ROOT / 'setup.sh'), '--test-tools-only'], cwd=ROOT,
                                    pass_fds=test_source.descriptors()).returncode
        return outcome(status, 'helper refresh failed; baseline acceptance is incomplete.' if status else
                       f'onpc_baseline prepared and accepted for {args.vm}.')
    except (ValueError, OSError) as error:
        return outcome(2, str(error))


if __name__ == '__main__':
    with test_source.admission(ROOT, sys.argv[1:]):
        sys.exit(main())
