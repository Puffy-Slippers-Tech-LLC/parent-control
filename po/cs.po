msgstr "Pomozte nám se zlepšovat"

#. Shared message: ANONYMOUS_BY_DEFAULT
msgid "Anonymous by default"
msgstr "Ve výchozím stavu anonymní"

#. Shared message: ADD_YOUR_EMAIL_IF_YOU_D_LIKE_A_REPLY_OTHERWISE_YOUR_FEEDBACK_IS
msgid "Add your email if you’d like a reply. Otherwise, your feedback is anonymous."
msgstr "Pokud chcete odpověď, přidejte svůj e-mail. Jinak je vaše zpětná vazba anonymní."

#. Shared message: NO_LOGS_ATTACHED
msgid "No logs attached"
msgstr "Žádné připojené protokoly"

#. Shared message: LATEST_3_LOG_DATES_SYSTEM_INFORMATION_ZIP_ARCHIVE
msgid "Latest 3 log dates · System information · ZIP archive"
msgstr "Poslední 3 data protokolů · Systémové informace · Archiv ZIP"

#. Shared message: YOUR_FEEDBACK_CAN_BE_SENT_WITHOUT_LOGS
msgid "Your feedback can be sent without logs."
msgstr "Vaši zpětnou vazbu lze odeslat bez protokolů."

#. Shared message: REMOVE_ATTACHMENT
msgid "Remove attachment"
msgstr "Odebrat přílohu"

#. Shared message: COULD_NOT_SAVE_LOGS_TRY_ANOTHER_LOCATION
msgid "Could not save logs. Try another location."
msgstr "Protokoly se nepodařilo uložit. Zkuste jiné umístění."

#. Shared message: REVIEW_THE_ERROR_DETAILS_BELOW_BEFORE_SENDING
msgid "Review the error details below before sending."
msgstr "Před odesláním zkontrolujte podrobnosti chyby níže."

#. Shared message: SHARE_A_PROBLEM_SUGGESTION_OR_IDEA
msgid "Share a problem, suggestion, or idea."
msgstr "Podělte se o problém, návrh nebo nápad."

#. Shared message: COULD_NOT_CHOOSE_ATTACHMENTS_TRY_AGAIN
msgid "Could not choose attachments. Try again."
msgstr "Přílohy se nepodařilo vybrat. Zkuste to znovu."

#. Shared message: COULD_NOT_READ_ONE_OR_MORE_ATTACHMENTS_TRY_DIFFERENT_FILES
msgid "Could not read one or more attachments. Try different files."
msgstr "Jednu nebo více příloh se nepodařilo přečíst. Zkuste jiné soubory."

#. Shared message: COULD_NOT_CHOOSE_A_DOWNLOAD_LOCATION_TRY_AGAIN
msgid "Could not choose a download location. Try again."
msgstr "Umístění pro stažení se nepodařilo vybrat. Zkuste to znovu."

#. Shared message: SOMETHING_WENT_WRONG
msgid "Something went wrong"
msgstr "Něco se pokazilo"

#. Shared message: THE_OPERATION_COULD_NOT_BE_COMPLETED_PLEASE_TRY_AGAIN_LATER
msgid "The operation could not be completed. Please try again later."
msgstr "Operaci se nepodařilo dokončit. Zkuste to prosím později."

#. Shared message: ERROR_REPORT_UNAVAILABLE
msgid "Error report unavailable"
msgstr "Hlášení o chybě není dostupné"

#. Shared message: THE_FEEDBACK_DIALOG_COULD_NOT_BE_OPENED_PLEASE_TRY_AGAIN_LATER
msgid "The feedback dialog could not be opened. Please try again later."
msgstr "Dialog zpětné vazby se nepodařilo otevřít. Zkuste to prosím později."

#. Shared message: CLOSE_THE_ERROR_REPORT_NOTICE
msgid "Close the error report notice."
msgstr "Zavře oznámení hlášení o chybě."

#. Shared message: FEEDBACK_REPLY_EMAIL_ADDRESSES_ATTACHMENTS_AND_DIAGNOSTIC_LOGS_A
msgid "Feedback, reply email addresses, attachments, and diagnostic logs are emailed to support. Retention depends on our support mailbox and service providers, including their backup policies. We do not currently guarantee deletion within a fixed period."
msgstr "Zpětná vazba, e-mailové adresy pro odpověď, přílohy a diagnostické protokoly se posílají e-mailem podpoře. Doba uchování závisí na naší schránce podpory a poskytovatelích služeb, včetně jejich zásad zálohování. V současnosti nezaručujeme smazání v pevně stanovené lhůtě."

#. Shared message: ENTER_A_SINGLE_LINE_FEEDBACK_TITLE_OF_AT_MOST_200_CHARACTERS
msgid "Enter a single-line feedback title of at most 200 characters."
msgstr "Zadejte jednořádkový název zpětné vazby s nejvýše 200 znaky."

#. Shared message: PLEASE_ENTER_YOUR_FEEDBACK
msgid "Please enter your feedback."
msgstr "Zadejte prosím svou zpětnou vazbu."

#. Shared message: YOUR_FEEDBACK_CONTAINS_AN_UNSUPPORTED_HIDDEN_CHARACTER_PLEASE_RE
msgid "Your feedback contains an unsupported hidden character. Please retype it and try again."
msgstr "Vaše zpětná vazba obsahuje nepodporovaný skrytý znak. Přepište ji prosím a zkuste to znovu."

#. Shared message: FEEDBACK_MUST_BE_AT_MOST_5_000_UTF_16_CHARACTERS_SOME_EMOJI_COUN
msgid "Feedback must be at most 5,000 UTF-16 characters (some emoji count as two)."
msgstr "Zpětná vazba musí mít nejvýše 5 000 znaků UTF-16 (některé emoji se počítají jako dva znaky)."

#. Shared message: THE_FORMATTED_FEEDBACK_IS_TOO_COMPLEX_REMOVE_SOME_FORMATTING_AND
msgid "The formatted feedback is too complex. Remove some formatting and try again."
msgstr "Formátovaná zpětná vazba je příliš složitá. Odeberte část formátování a zkuste to znovu."

#. Shared message: ENTER_A_BARE_REPLY_EMAIL_ADDRESS_OR_LEAVE_IT_BLANK
msgid "Enter a bare reply email address, or leave it blank."
msgstr "Zadejte pouze e-mailovou adresu pro odpověď nebo nechte pole prázdné."

#. Shared message: THE_APP_VERSION_IS_INVALID_PLEASE_UPDATE_THE_APPLICATION
msgid "The app version is invalid. Please update the application."
msgstr "Verze aplikace je neplatná. Aktualizujte prosím aplikaci."

