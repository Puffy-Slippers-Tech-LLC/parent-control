#. Shared message: FEEDBACK_MUST_BE_AT_MOST_5_000_UTF_16_CHARACTERS_SOME_EMOJI_COUN
msgid "Feedback must be at most 5,000 UTF-16 characters (some emoji count as two)."
msgstr "प्रतिक्रिया बढीमा 5,000 UTF-16 अक्षरको हुनुपर्छ (केही इमोजी दुई गनिन्छन्)।"

