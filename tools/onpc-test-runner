#!/usr/bin/python3 -IB
"""Installed development-only dispatcher; trust the configured test checkout."""

# Disable bytecode in this privileged interpreter as well as its children.
# Checkout imports must never leave root-owned caches that break package clean.

import argparse
from contextlib import nullcontext
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import runpy
import subprocess
import sys


def retention_guard(root):
    """Read recovery state under the existing VM lease; never repair it here."""
    sys.path.insert(0, str(root / 'tests/integration'))
    import prepare_baseline as baseline
    baseline.canonical(baseline.BASELINES)
    lock_path = baseline.baseline_lock_path(baseline.BASELINES)
    fd = os.open(lock_path, os.O_RDWR | os.O_NOFOLLOW)
    try:
        baseline.identity(lock_path, private=True, mode=0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        for name, phase in (('phase.json', 'finalized'), ('system-run.json', 'complete')):
            path = baseline.BASELINES / name
            if name != 'phase.json' and not os.path.lexists(path):
                continue
            baseline.identity(path, private=True, mode=0o600)
            if json.loads(path.read_bytes()).get('phase') != phase:
                raise ValueError('retention: VM recovery is unfinished; preserve evidence')
    finally:
        os.close(fd)

CHECKOUT = None  # Replaced with an absolute path by install_test_runner.py.
VM_UUID = None  # Pinned from finalized baseline state by install_test_runner.py.


class ArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError('test-runner:invalid-arguments; use --help')


def confined_file(root, relative):
    root = root.resolve()
    candidate = root / relative
    for component in (candidate, *candidate.parents):
        if component == root:
            break
        if component.is_symlink():
            raise ValueError('test-runner:invalid-test-path')
    if not candidate.is_file() or not candidate.resolve().is_relative_to(root.resolve()):
        raise ValueError('test-runner:missing-or-external-test')
    return candidate


def selection(root, argv, *, allow_missing_artifacts=False):
    parser = ArgumentParser(description=__doc__, allow_abbrev=False)
    categories = parser.add_subparsers(dest='category', required=True)
    integration = categories.add_parser('integration', allow_abbrev=False)
    integration.add_argument('test', help='check_* basename, with optional .py suffix')
    system = categories.add_parser('system', allow_abbrev=False)
    system.add_argument('--artifacts', type=Path)
    system.add_argument('--previous-artifacts', type=Path)
    system.add_argument('--area')
    system.add_argument('--test')
    system.add_argument('--list', action='store_true')
    system.add_argument('--qualification-failure', action='store_true')
    system.add_argument('--skip-backing-verification', action='store_true')
    e2e = categories.add_parser('e2e', allow_abbrev=False)
    e2e.add_argument('--artifacts', type=Path)
    selectors = e2e.add_mutually_exclusive_group()
    selectors.add_argument('--scenario')
    selectors.add_argument('--id', help='comma-separated numeric case IDs in docs/Test-Coverage.md')
    selectors.add_argument('--ready', action='store_true')
    e2e.add_argument('--list', action='store_true')
    e2e.add_argument('--skip-backing-verification', action='store_true')
    qualification = e2e.add_mutually_exclusive_group()
    qualification.add_argument('--qualify-transfer', action='store_true')
    qualification.add_argument('--qualify-install', action='store_true')
    qualification.add_argument('--qualify-install-refusal', action='store_true')
    appsnapshot = categories.add_parser('appsnapshot', allow_abbrev=False)
    appsnapshot.add_argument('--probe', action='store_true')
    appsnapshot.add_argument('--artifacts', type=Path)
    appsnapshot.add_argument('--overwrite', choices=('true', 'false'), default='true',
                            nargs='?', const='true')
    vm = categories.add_parser('vm', allow_abbrev=False)
    vm.add_argument('action', choices=('status', 'xml', 'start', 'stop', 'reboot',
                                      'reset', 'screenshot', 'send-key'))
    vm.add_argument('keys', nargs='*', type=int)
    args = parser.parse_args(argv)
    if args.category == 'appsnapshot':
        if VM_UUID is None:
            raise ValueError('test-runner:prepare-baseline-and-refresh-test-tools')
        target = confined_file(root, 'tests/e2e/prepare_snapshot.py')
        command = ['/usr/bin/python3', '-B', str(target), '--expected-uuid', VM_UUID]
        if args.probe:
            if args.artifacts is not None:
                raise ValueError('test-runner:probe-does-not-use-artifacts')
            return [*command, '--probe']
        runner = runpy.run_path(str(confined_file(root, 'tests/e2e/runner.py')))
        runner['validate_artifact_path'](args.artifacts)
        if not args.artifacts.is_dir():
            raise ValueError('test-runner:missing-artifact-directory')
        return [*command, '--overwrite', args.overwrite, '--artifacts', str(args.artifacts)]
    if args.category == 'vm':
        if (args.action == 'send-key' and not 1 <= len(args.keys) <= 16) or (
                args.action != 'send-key' and args.keys) or any(not 1 <= key <= 255 for key in args.keys):
            raise ValueError('test-runner:invalid-vm-keycodes')
        if VM_UUID is None:
            raise ValueError('test-runner:prepare-baseline-and-refresh-test-tools')
        target = confined_file(root, 'tests/integration/vm_control.py')
        return ['/usr/bin/python3', '-B', str(target), '--expected-uuid', VM_UUID,
                args.action, *map(str, args.keys)]
    if args.category == 'integration':
        name = args.test.removesuffix('.py')
        if not re.fullmatch(r'check_[a-z][a-z0-9_]*', name):
            raise ValueError('test-runner:invalid-test-name')
        target = confined_file(root, f'tests/integration/{name}.py')
        return ['/usr/bin/python3', '-B', str(target)]
    if args.category == 'e2e':
        target = confined_file(root, 'tests/e2e/runner.py')
        options = ['--list'] if args.list else []
        if args.ready:
            options.append('--ready')
        if args.skip_backing_verification:
            options.append('--skip-backing-verification')
        if args.qualify_transfer:
            options.append('--qualify-transfer')
        if args.qualify_install:
            options.append('--qualify-install')
        if args.qualify_install_refusal:
            options.append('--qualify-install-refusal')
        if args.scenario is not None:
            options.append('--scenario=' + args.scenario)
        if args.id is not None:
            options.append('--id=' + str(args.id))
        if args.artifacts is not None:
            options.append('--artifacts=' + str(args.artifacts))
        # Validate inventory before either caller privilege checks or isolated
        # safety tests. The installed dispatcher repeats this checkout preflight.
        plan = runpy.run_path(str(target))['preflight'](
            options, root=root, allow_missing_artifacts=allow_missing_artifacts)
        if args.id is not None and len(plan['cases']) == 1:
            options.remove('--id=' + str(args.id))
            options.append('--scenario=' + plan['selector'])
        return ['/usr/bin/python3', '-B', str(target), *options]
    else:
        target = confined_file(root, 'tests/integration/system_runner.py')
    command = ['/usr/bin/python3', '-B', str(target)]
    if not args.list and args.artifacts is None:
        parser.error('system requires --artifacts unless --list is supplied')
    for option in ('artifacts', 'previous_artifacts'):
        artifact = getattr(args, option, None)
        if artifact is None:
            continue
        if not artifact.is_absolute():
            parser.error('artifact directories must be absolute')
        parts = artifact.parts
        if ('..' in parts or not any(artifact.is_relative_to(base) and
                len(parts) > len(base.parts) and re.fullmatch(r'onpc-[A-Za-z0-9_.-]+', parts[len(base.parts)])
                for base in (Path('/tmp'), Path('/var/tmp'))) or
                any(p.is_symlink() for p in (artifact, *artifact.parents))):
            raise ValueError('test-runner:invalid-artifact-directory')
        command += ['--' + option.replace('_', '-'), str(artifact)]
    for option in ('area', 'test'):
        value = getattr(args, option)
        if value is not None:
            if not value or len(value) > 512 or any(ord(c) < 32 for c in value):
                raise ValueError('test-runner:invalid-selector')
            command.append(f'--{option}={value}')
    if args.list and args.category == 'system':
        command.append('--list')
    if getattr(args, 'qualification_failure', False):
        command.append('--qualification-failure')
    if args.skip_backing_verification:
        command.append('--skip-backing-verification')
    return command


def run(root, argv, caller):
    retention_run = None
    if argv and argv[0].startswith('--retention-run='):
        retention_run = argv[0].partition('=')[2]
        if not re.fullmatch('[0-9a-f]{32}', retention_run):
            raise ValueError('test-runner:invalid-retention-run')
        argv = argv[1:]
        if argv[:1] != ['--unattended']:
            raise ValueError('test-runner:retention-requires-unattended')
    if argv[:1] == ['--unattended']:
        # This fixed mode accepts the same validated selections. Stdin is a
        # cancellation channel, never a command or privileged path source.
        argv = argv[1:]
        command = selection(root, argv)
        if argv[0] not in ('integration', 'system', 'e2e', 'appsnapshot') or '--list' in argv or '--probe' in argv:
            raise ValueError('test-runner:invalid-unattended-category')
        if retention_run and argv[0] == 'integration':
            raise ValueError('test-runner:invalid-retention-category')
        module = runpy.run_path(str(confined_file(root, 'tools/regression_process.py')))
        sys.path.insert(0, str(root / 'tools'))
        environment = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8',
                       'HOME': caller.pw_dir, 'PYTHONDONTWRITEBYTECODE': '1',
                       'PYTHONUNBUFFERED': '1'}
        with module['Control']().installed(pipe=True) as control:
            print('test-runner: cleanup prerequisites starting (unprivileged)', flush=True)
            status = control.run(module['safety_command'](root), cwd=root, env=environment,
                                 user=caller.pw_uid, group=caller.pw_gid,
                                 extra_groups=os.getgrouplist(caller.pw_name, caller.pw_gid))
            if status:
                print('test-runner: cleanup prerequisites failed; selected operation was not started',
                      file=sys.stderr, flush=True)
                return status
            print('test-runner: cleanup prerequisites passed; selected operation starting', flush=True)
            environment.update(PKEXEC_UID=str(caller.pw_uid), HOME='/root')
            import test_retention
            checkout_id = hashlib.sha256(str(root).encode()).hexdigest()[:16]
            store = test_retention.Store(Path('/var/tmp') /
                f'onpc-test-retention-root-{caller.pw_uid}-{checkout_id}')
            context = (store.session(run=retention_run, guard=lambda: retention_guard(root),
                                     preserve_completed=test_retention.legacy_system_evidence)
                       if retention_run else nullcontext())
            with context:
                environment.update(test_retention.environment())
                return control.run(command, cwd=root, env=environment)
    command = selection(root, argv)
    environment = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8',
                   'HOME': caller.pw_dir, 'PYTHONDONTWRITEBYTECODE': '1'}
    if argv[0] in ('system', 'e2e') and '--list' in argv:
        return subprocess.run(command, cwd=root, env=environment, user=caller.pw_uid,
                              group=caller.pw_gid,
                              extra_groups=os.getgrouplist(caller.pw_name, caller.pw_gid),
                              check=False).returncode
    if argv[:2] in (['vm', 'status'], ['vm', 'xml'], ['vm', 'screenshot']):
        environment['PKEXEC_UID'] = str(caller.pw_uid)
        return subprocess.run(command, cwd=root, env=environment, check=False).returncode
    if argv[0] == 'appsnapshot' and '--probe' in argv:
        return subprocess.run(command, cwd=root, env=environment, check=False).returncode
    safety = sorted((root / 'tests/unit').glob('test_*cleanup_safety.py'))
    if not safety:
        raise ValueError('test-runner:missing-cleanup-prerequisites')
    safety.append(root / 'tests/unit/test_graphical_lease.py')
    safety = [str(confined_file(root, p.relative_to(root))) for p in safety]
    print('test-runner: cleanup prerequisites starting (unprivileged)', flush=True)
    result = subprocess.run(
        ['/usr/bin/python3', '-B', '-m', 'pytest', '-p', 'no:cacheprovider', *safety, '-q'],
        cwd=root, env=environment, user=caller.pw_uid, group=caller.pw_gid,
        extra_groups=os.getgrouplist(caller.pw_name, caller.pw_gid), check=False)
    if result.returncode:
        print('test-runner: cleanup prerequisites failed; test refused', file=sys.stderr)
        return result.returncode
    print('test-runner: cleanup prerequisites passed; selected test starting', flush=True)
    # Preserve pkexec's authenticated graphical-caller identity for the VM runner.
    environment['PKEXEC_UID'] = str(caller.pw_uid)
    environment['HOME'] = '/root'
    result = subprocess.run(command, cwd=root, env=environment, check=False)
    print(f'test-runner: selected test finished (status={result.returncode})', flush=True)
    return result.returncode


def main():
    try:
        if CHECKOUT is None:
            raise ValueError('test-runner:installation-required')
        if os.geteuid() != 0:
            raise ValueError('test-runner:pkexec-required')
        uid = int(os.environ.get('PKEXEC_UID', '0'))
        if uid <= 0:
            raise ValueError('test-runner:unprivileged-caller-required')
        return run(Path(CHECKOUT), sys.argv[1:], pwd.getpwuid(uid))
    except (ValueError, KeyError, OSError) as error:
        detail = str(error) if isinstance(error, ValueError) and str(error).startswith(
            ('retention:', 'test-runner:')) else type(error).__name__
        print('test-runner: ' + detail, file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
