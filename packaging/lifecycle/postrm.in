#!/bin/sh
set -e

@notice_cleanup@
check_tree() {
    # Only fixed product paths below. Never follow links or cross filesystems.
    if [ -L "$1" ]; then
        echo 'oh-no-parent-control: refusing cleanup of a substituted directory' >&2
        exit 1
    fi
    if [ -d "$1" ]; then
        # -xdev alone does not detect a bind mount on the same filesystem.
        # Check mount points before deleting any content, including the root.
        mounted=$(find "$1" -xdev -type d -exec mountpoint -q {} \; -print -quit)
        if [ -n "$mounted" ]; then
            echo 'oh-no-parent-control: refusing cleanup of a mounted directory' >&2
            exit 1
        fi
    fi
}

remove_tree() {
    check_tree "$1"
    if [ -d "$1" ]; then
        find "$1" -xdev -depth -delete
    fi
}

remove_integration() {
    if [ -L "$2" ]; then
        echo 'oh-no-parent-control: unsafe integration ownership record' >&2
        exit 1
    fi
    if [ ! -f "$2" ]; then
        return
    fi
    if [ -e "$1" ] || [ -L "$1" ]; then
        if [ -L "$1" ] || ! cmp -s "$1" "$2"; then
            echo 'oh-no-parent-control: preserving modified system integration' >&2
            exit 1
        fi
        rm -f "$1"
    fi
    rm -f "$2"
}

remove_package_created_kiosk() {
    kiosk_user=oh-no-parent-control
    marker=/var/lib/oh-no-parent-control/package-created-kiosk-uid
    if [ -L "$marker" ]; then
        echo 'oh-no-parent-control: unsafe kiosk ownership marker' >&2
        exit 1
    fi
    if [ ! -f "$marker" ]; then return; fi
    if [ "$(stat -c '%u:%a' "$marker")" != 0:600 ]; then
        echo 'oh-no-parent-control: unsafe kiosk ownership marker' >&2
        exit 1
    fi
    marker_uid=$(cat "$marker")
    case "$marker_uid" in
        ''|*[!0-9]*|0)
            echo 'oh-no-parent-control: invalid kiosk ownership marker' >&2
            exit 1 ;;
    esac
    entry=$(getent passwd "$kiosk_user" || true)
    # Verify mounts before deleting the account: failure must retain the
    # identity as well as its home so an administrator can resolve the mount.
    check_tree /home/oh-no-parent-control
    if [ -n "$entry" ]; then
        account_uid=$(printf '%s\n' "$entry" | cut -d: -f3)
        account_home=$(printf '%s\n' "$entry" | cut -d: -f6)
        if [ "$account_uid" != "$marker_uid" ] ||
           [ "$account_home" != /home/oh-no-parent-control ]; then
            echo 'oh-no-parent-control: preserving changed kiosk identity' >&2
            exit 1
        fi
    elif getent passwd "$marker_uid" >/dev/null; then
        echo 'oh-no-parent-control: preserving reassigned kiosk identity' >&2
        exit 1
    fi
    if [ -d /run/systemd/system ] &&
       systemctl is-active --quiet "user@$marker_uid.service"; then
        echo 'oh-no-parent-control: log out of the kiosk session before removal' >&2
        exit 1
    fi
    if [ -L /home/oh-no-parent-control ] ||
       { [ -d /home/oh-no-parent-control ] &&
         [ "$(stat -c %u /home/oh-no-parent-control)" != "$marker_uid" ]; }; then
        echo 'oh-no-parent-control: preserving substituted kiosk home' >&2
        exit 1
    fi
    if [ -n "$entry" ]; then
        # Use AccountsService's public API while the identity still exists so
        # the kiosk's cached icon/session metadata is removed as well.
        if command -v busctl >/dev/null && [ -d /run/systemd/system ]; then
            busctl --system call org.freedesktop.Accounts /org/freedesktop/Accounts \
                org.freedesktop.Accounts UncacheUser s "$kiosk_user"
        fi
        # Keep filesystem deletion in remove_tree so a mounted subtree cannot
        # be traversed by an account-management tool.
        @delete_account@
    fi
    # deluser can leave files owned by other UIDs in the package-created home.
    # Retain the marker until the entire verified home is gone, including retries.
    remove_tree /home/oh-no-parent-control
    if [ -f /var/mail/oh-no-parent-control ] && \
       [ "$(stat -c %u /var/mail/oh-no-parent-control)" = "$marker_uid" ]; then
        rm -f /var/mail/oh-no-parent-control
    fi
    rm -f "$marker"
    echo 'oh-no-parent-control: kiosk cleanup outcome=accepted' >&2
}

restore_execution_policy() {
    baseline=/var/lib/oh-no-parent-control/fapolicyd-before-install
    if [ -L "$baseline" ]; then
        echo 'oh-no-parent-control: unsafe execution-policy baseline' >&2
        exit 1
    fi
    if [ ! -d "$baseline" ]; then
        return
    fi
    if [ ! -f "$baseline/complete" ]; then
        echo 'oh-no-parent-control: incomplete execution-policy baseline' >&2
        exit 1
    fi
    for policy_file in compiled.rules compiled.rules.prev; do
        if [ -L "$baseline/$policy_file" ] || [ -L "/etc/fapolicyd/$policy_file" ]; then
            echo 'oh-no-parent-control: refusing substituted compiled policy path' >&2
            exit 1
        fi
    done
    remaining_rules=0
    for rule in /etc/fapolicyd/rules.d/*.rules; do
        if [ -f "$rule" ]; then remaining_rules=1; break; fi
    done
    if [ "$remaining_rules" -eq 1 ]; then
        # Preserve rules belonging to other software/admins and their service.
        /usr/sbin/fagenrules
        if [ -d /run/systemd/system ] && systemctl is-active --quiet fapolicyd.service; then
            /usr/sbin/fapolicyd-cli --reload-rules
        fi
    else
        # fagenrules leaves compiled and live policy unchanged for an empty
        # source directory. Restore the pre-install policy explicitly.
        if [ ! -f "$baseline/active" ] && [ -d /run/systemd/system ]; then
            @service_command@ stop fapolicyd.service >/dev/null
            if systemctl is-active --quiet fapolicyd.service; then
                echo 'oh-no-parent-control: execution-policy service did not stop' >&2
                exit 1
            fi
        fi
        if [ -f "$baseline/compiled.rules" ]; then
            cp -p "$baseline/compiled.rules" /etc/fapolicyd/compiled.rules
        else
            rm -f /etc/fapolicyd/compiled.rules
        fi
        if [ -f "$baseline/active" ] && [ -d /run/systemd/system ]; then
            /usr/sbin/fapolicyd-cli --reload-rules
        fi
        if [ ! -f "$baseline/enabled" ] && [ -d /run/systemd/system ]; then
            systemctl disable fapolicyd.service >/dev/null
        fi
    fi
    # fagenrules creates this backup as well as the compiled file.
    if [ -f "$baseline/compiled.rules.prev" ]; then
        cp -p "$baseline/compiled.rules.prev" /etc/fapolicyd/compiled.rules.prev
    else
        rm -f /etc/fapolicyd/compiled.rules.prev
    fi
    remove_tree /var/lib/oh-no-parent-control/fapolicyd-before-install
    echo 'oh-no-parent-control: execution-policy cleanup outcome=accepted' >&2
}

restore_child_trust_backend() {
    trust_backend=/var/lib/oh-no-parent-control/child-trust-backend
    trust_config=/etc/fapolicyd/fapolicyd.conf
    if [ -L "$trust_backend" ]; then
        echo 'oh-no-parent-control: unsafe child trust backend record' >&2
        exit 1
    fi
    if [ ! -e "$trust_backend" ]; then return; fi
    for trust_path in "$trust_backend/before" "$trust_backend/after" "$trust_config"; do
        if [ -L "$trust_path" ] || [ ! -f "$trust_path" ]; then
            echo 'oh-no-parent-control: unsafe child trust backend path' >&2
            exit 1
        fi
    done
    if ! cmp -s "$trust_config" "$trust_backend/before" &&
       ! cmp -s "$trust_config" "$trust_backend/after"; then
        echo 'oh-no-parent-control: preserving modified child trust backend configuration' >&2
        exit 1
    fi
    trust_temporary=$(mktemp /etc/fapolicyd/.onpc-trust-XXXXXX)
    cp -p "$trust_backend/before" "$trust_temporary"
    mv -f "$trust_temporary" "$trust_config"
    trust_backend_restored=1
}

if [ "$1" = remove ] || [ "$1" = purge ]; then
    # Check every recursively removed root before any irreversible cleanup.
    check_tree /var/lib/oh-no-parent-control
    if [ "$1" = purge ]; then check_tree /var/log/oh-no-parent-control; fi
    if [ -L /etc/fapolicyd ]; then
        echo 'oh-no-parent-control: refusing substituted child trust directory' >&2
        exit 1
    fi
    restore_child_trust_backend
    remove_integration @gdm_presession_dir@/Default \
        /var/lib/oh-no-parent-control/installed-gdm-presession
    remove_integration /etc/fapolicyd/rules.d/99-oh-no-parent-control-allow.rules \
        /var/lib/oh-no-parent-control/installed-fapolicyd-fallback
@readiness_remove_rule@
    if [ -L /etc/fapolicyd ] || [ -L /etc/fapolicyd/trust.d ]; then
        echo 'oh-no-parent-control: refusing substituted child trust directory' >&2
        exit 1
    fi
    remove_integration /etc/fapolicyd/trust.d/oh-no-parent-control.trust \
        /var/lib/oh-no-parent-control/installed-child-extension-trust
    if [ -d /run/systemd/system ] && systemctl is-active --quiet fapolicyd.service; then
        /usr/sbin/fapolicyd-cli --update
    fi
    rm -f \
        /etc/fapolicyd/rules.d/01-oh-no-parent-control-deny.rules \
        /etc/fapolicyd/rules.d/89-oh-no-parent-control.rules \
        /etc/oh-no-parent-control/config.json \
        /usr/share/dbus-1/system.d/com.puffyslippers.OhNoParentControl1.conf
    # The package manager has removed our display-manager dependency. Forget
    # it before stopping readiness/fapolicyd or systemd would stop the desktop.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
@readiness_remove@
    fi
    restore_execution_policy
    if [ "${trust_backend_restored:-0}" -eq 1 ]; then
        if [ -d /run/systemd/system ] && systemctl is-active --quiet fapolicyd.service; then
            @service_command@ restart fapolicyd.service >/dev/null
        fi
        remove_tree /var/lib/oh-no-parent-control/child-trust-backend
    fi
    @bus_reload@ >/dev/null || true
    remove_package_created_kiosk
    if [ -f /var/lib/oh-no-parent-control/uninstall-broker-mask ]; then
        if [ "$(readlink /run/systemd/system/oh-no-parent-control-broker.service)" = /dev/null ]; then
            systemctl unmask --runtime oh-no-parent-control-broker.service >/dev/null
        fi
        rm -f /var/lib/oh-no-parent-control/uninstall-broker-mask
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if systemctl is-failed --quiet oh-no-parent-control-broker.service; then
            systemctl reset-failed oh-no-parent-control-broker.service
        fi
    fi
    rm -f \
        /var/lib/oh-no-parent-control/migration-in-progress \
        /var/lib/oh-no-parent-control/package-activation-pending \
        /var/lib/oh-no-parent-control/previous-package-activation.json \
        /var/lib/oh-no-parent-control/uninstall-enforcement.json \
        /var/lib/oh-no-parent-control/malcontent-pam-before-install \
        /var/lib/oh-no-parent-control/data-migration.lock \
        /var/lib/oh-no-parent-control/first-install-in-progress
    remove_tree /var/lib/oh-no-parent-control/fapolicyd-before-install.pending
@distribution_cleanup@
fi

if [ "$1" = purge ]; then
    remove_tree /var/lib/oh-no-parent-control
    remove_tree /var/log/oh-no-parent-control
    echo 'oh-no-parent-control: saved-state purge outcome=accepted' >&2
fi

if [ "$1" = abort-install ] && [ -z "${2:-}" ] &&
   [ -f /var/lib/oh-no-parent-control/first-install-in-progress ]; then
    # preinst only captured policy; configuration never activated it. Remove
    # that attempt's bookkeeping without touching saved customer preferences.
    check_tree /var/lib/oh-no-parent-control
    remove_tree /var/lib/oh-no-parent-control/fapolicyd-before-install.pending
    remove_tree /var/lib/oh-no-parent-control/fapolicyd-before-install
    rm -f /var/lib/oh-no-parent-control/first-install-in-progress \
        /var/lib/oh-no-parent-control/migration-in-progress \
        /var/lib/oh-no-parent-control/package-activation-pending \
        /var/lib/oh-no-parent-control/previous-package-activation.json
fi

rmdir /etc/oh-no-parent-control 2>/dev/null || true
rmdir /var/lib/oh-no-parent-control 2>/dev/null || true

#DEBHELPER#

if [ "$1" = remove ]; then
@reboot_remove@
fi

exit 0
