Name: Oh No Parent Control managed session limits
Default: yes
Priority: 1000
Account-Type: Additional
Account:
 [success=4 default=ignore] pam_succeed_if.so quiet service = systemd-user
 [success=3 default=ignore] pam_succeed_if.so quiet user = oh-no-parent-control
 [success=2 default=ignore] pam_succeed_if.so quiet user ingroup sudo
 [success=1 default=ignore] pam_exec.so quiet quiet_log /usr/libexec/oh-no-parent-control-session-limit-check
 required pam_malcontent.so
Session-Type: Additional
Session:
 optional pam_exec.so quiet /usr/libexec/oh-no-parent-control-clear-session-runtime-max
