Name:           oh-no-parent-control
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Administrator controls and a child request station for GNOME
License:        GPL-3.0-only AND BSD-3-Clause AND OFL-1.1
URL:            https://github.com/Puffy-Slippers-Tech-LLC/parent-control
Source0:        %{name}-%{version}.tar.xz
ExclusiveArch:  x86_64

BuildRequires:  gcc
BuildRequires:  gettext
BuildRequires:  make
BuildRequires:  pam-devel
BuildRequires:  glib2
BuildRequires:  nodejs
BuildRequires:  python3
BuildRequires:  redhat-rpm-config
BuildRequires:  systemd-rpm-macros

