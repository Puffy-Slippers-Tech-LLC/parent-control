{
  "name": "onpc-watch",
  "displayName": "ONPC Watch",
  "description": "Run status and live UI/VM viewers in a VS Code editor tab.",
  "version": "0.3.0",
  "publisher": "puffyslippers",
  "license": "SEE LICENSE IN LICENSE",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Testing", "Visualization"],
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "configuration": {
      "title": "ONPC Watch",
      "properties": {
        "onpc.watch.sources": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "restricted": true,
          "maxItems": 16,
          "markdownDescription": "Watch bridge sources. Empty uses the current local checkout and SSH hosts with branches in config/environment.json, including hosts disabled for VM scheduling. Reconnect Watch after changing. SSH uses existing SSH config and keys; commands run only in a trusted workspace.",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
              "label": { "type": "string", "maxLength": 128 },
              "transport": { "type": "string", "enum": ["local", "ssh"], "default": "local" },
              "host": { "type": "string", "description": "SSH config alias or user@host. Required for SSH." },
              "root": { "type": "string", "description": "Absolute checkout path on the source host. Required for SSH." },
              "command": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Optional adapter argv implementing Watch bridge protocol 1. Defaults to the source checkout's local reader." }
            }
          }
        }
      }
    },
    "commands": [{
      "command": "onpc.watch", "category": "ONPC", "title": "Watch",
      "icon": "media/app-logo.png"
    }],
    "menus": {
      "editor/title": [{
        "command": "onpc.watch",
        "when": "onpc.watchAvailable && isWorkspaceTrusted",
        "group": "navigation@100"
      }]
    }
  }
}
