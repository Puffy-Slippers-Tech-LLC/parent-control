#!/usr/bin/python3 -I
"""Installed development-only dispatcher; trust the configured test checkout."""

import argparse
import os
from pathlib import Path
import pwd
import re
import subprocess
import sys

CHECKOUT = None  # Replaced with an absolute path by install_test_runner.py.
VM_UUID = None  # Pinned from finalized baseline state by install_test_runner.py.


class ArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError('test-runner:invalid-arguments; use --help')


def confined_file(root, relative):
    root = root.resolve()
    candidate = root / relative
    for component in (candidate, *candidate.parents):
        if component == root:
            break
        if component.is_symlink():
            raise ValueError('test-runner:invalid-test-path')
    if not candidate.is_file() or not candidate.resolve().is_relative_to(root.resolve()):
        raise ValueError('test-runner:missing-or-external-test')
    return candidate


def selection(root, argv):
    parser = ArgumentParser(description=__doc__, allow_abbrev=False)
    categories = parser.add_subparsers(dest='category', required=True)
    integration = categories.add_parser('integration', allow_abbrev=False)
    integration.add_argument('test', help='check_* basename, with optional .py suffix')
    system = categories.add_parser('system', allow_abbrev=False)
    system.add_argument('--artifacts', type=Path)
    system.add_argument('--area')
    system.add_argument('--test')
    system.add_argument('--list', action='store_true')
    system.add_argument('--qualification-failure', action='store_true')
    e2e = categories.add_parser('e2e', allow_abbrev=False)
    e2e.add_argument('--artifacts', type=Path)
    e2e.add_argument('--scenario')
    e2e.add_argument('--list', action='store_true')
    vm = categories.add_parser('vm', allow_abbrev=False)
    vm.add_argument('action', choices=('status', 'xml', 'start', 'stop', 'reboot',
                                      'reset', 'screenshot', 'send-key'))
    vm.add_argument('keys', nargs='*', type=int)
    args = parser.parse_args(argv)
    if args.category == 'vm':
        if (args.action == 'send-key' and not 1 <= len(args.keys) <= 16) or (
                args.action != 'send-key' and args.keys) or any(not 1 <= key <= 255 for key in args.keys):
            raise ValueError('test-runner:invalid-vm-keycodes')
        if VM_UUID is None:
            raise ValueError('test-runner:prepare-baseline-and-refresh-test-tools')
        target = confined_file(root, 'tests/integration/vm_control.py')
        return ['/usr/bin/python3', '-B', str(target), '--expected-uuid', VM_UUID,
                args.action, *map(str, args.keys)]
    if args.category == 'integration':
        name = args.test.removesuffix('.py')
        if not re.fullmatch(r'check_[a-z][a-z0-9_]*', name):
            raise ValueError('test-runner:invalid-test-name')
        target = confined_file(root, f'tests/integration/{name}.py')
        return ['/usr/bin/python3', '-B', str(target)]
    if args.category == 'e2e':
        target = confined_file(root, 'tests/e2e/inventory.py' if args.list else 'tests/e2e/runner.py')
    else:
        target = confined_file(root, 'tests/integration/system_runner.py')
    command = ['/usr/bin/python3', '-B', str(target)]
    if not args.list and args.artifacts is None:
        parser.error('system requires --artifacts unless --list is supplied')
    if args.artifacts is not None:
        if not args.artifacts.is_absolute():
            parser.error('--artifacts must be absolute')
        parts = args.artifacts.parts
        if ('..' in parts or not any(args.artifacts.is_relative_to(base) and
                len(parts) > len(base.parts) and re.fullmatch(r'onpc-[A-Za-z0-9_.-]+', parts[len(base.parts)])
                for base in (Path('/tmp'), Path('/var/tmp'))) or
                any(p.is_symlink() for p in (args.artifacts, *args.artifacts.parents))):
            raise ValueError('test-runner:invalid-artifact-directory')
        if args.category == 'e2e' and args.list:
            raise ValueError('test-runner:listing-does-not-use-artifacts')
        command += ['--artifacts', str(args.artifacts)]
    for option in (('scenario',) if args.category == 'e2e' else ('area', 'test')):
        value = getattr(args, option)
        if value is not None:
            if not value or len(value) > 512 or any(ord(c) < 32 for c in value):
                raise ValueError('test-runner:invalid-selector')
            command.append(f'--{option}={value}')
    if args.list and args.category == 'system':
        command.append('--list')
    if getattr(args, 'qualification_failure', False):
        command.append('--qualification-failure')
    return command


def run(root, argv, caller):
    command = selection(root, argv)
    environment = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8',
                   'HOME': caller.pw_dir, 'PYTHONDONTWRITEBYTECODE': '1'}
    if argv[0] in ('system', 'e2e') and '--list' in argv:
        return subprocess.run(command, cwd=root, env=environment, user=caller.pw_uid,
                              group=caller.pw_gid,
                              extra_groups=os.getgrouplist(caller.pw_name, caller.pw_gid),
                              check=False).returncode
    if argv[:2] in (['vm', 'status'], ['vm', 'xml'], ['vm', 'screenshot']):
        return subprocess.run(command, cwd=root, env=environment, check=False).returncode
    safety = sorted((root / 'tests/unit').glob('test_*cleanup_safety.py'))
    if not safety:
        raise ValueError('test-runner:missing-cleanup-prerequisites')
    safety.append(root / 'tests/unit/test_graphical_lease.py')
    safety = [str(confined_file(root, p.relative_to(root))) for p in safety]
    print('test-runner: cleanup prerequisites starting (unprivileged)', flush=True)
    result = subprocess.run(
        ['/usr/bin/python3', '-B', '-m', 'pytest', '-p', 'no:cacheprovider', *safety, '-q'],
        cwd=root, env=environment, user=caller.pw_uid, group=caller.pw_gid,
        extra_groups=os.getgrouplist(caller.pw_name, caller.pw_gid), check=False)
    if result.returncode:
        print('test-runner: cleanup prerequisites failed; test refused', file=sys.stderr)
        return result.returncode
    print('test-runner: cleanup prerequisites passed; selected test starting', flush=True)
    # Preserve pkexec's authenticated graphical-caller identity for the VM runner.
    environment['PKEXEC_UID'] = str(caller.pw_uid)
    environment['HOME'] = '/root'
    result = subprocess.run(command, cwd=root, env=environment, check=False)
    print(f'test-runner: selected test finished (status={result.returncode})', flush=True)
    return result.returncode


def main():
    try:
        if CHECKOUT is None:
            raise ValueError('test-runner:installation-required')
        if os.geteuid() != 0:
            raise ValueError('test-runner:pkexec-required')
        uid = int(os.environ.get('PKEXEC_UID', '0'))
        if uid <= 0:
            raise ValueError('test-runner:unprivileged-caller-required')
        return run(Path(CHECKOUT), sys.argv[1:], pwd.getpwuid(uid))
    except (ValueError, KeyError, OSError):
        print('test-runner: invalid request, missing prerequisite, or execution failure', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
