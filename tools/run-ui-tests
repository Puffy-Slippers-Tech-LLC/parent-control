#!/bin/sh

set -eu

timeout_duration=60s
if [ "${1:-}" = "--timeout" ]; then
    if [ "$#" -lt 2 ]; then
        echo "usage: tools/run-ui-tests [--timeout DURATION] [pytest arguments...]" >&2
        exit 2
    fi
    timeout_duration=$2
    shift 2
fi

case "$timeout_duration" in
    *[!0-9smhd.]*|'')
        echo "tools/run-ui-tests: invalid timeout duration: $timeout_duration" >&2
        exit 2
        ;;
esac

if [ ! -x ".venv/onpc-ui-tests/bin/python" ]; then
    echo "tools/run-ui-tests: UI test environment missing; run ./setup.sh" >&2
    exit 1
fi

echo "tools/run-ui-tests: running non-VM UI tests with timeout $timeout_duration" >&2
exec timeout "$timeout_duration" env \
    PYTHONDONTWRITEBYTECODE=1 \
    "PYTHONPATH=broker:kiosk:$PWD:${PYTHONPATH:-}" \
    .venv/onpc-ui-tests/bin/python -m pytest "$@"
