#!/usr/bin/python3
import sys

sys.path.insert(0, "/usr/lib/oh-no-parent-control/parent")
sys.path.insert(0, "/usr/lib/oh-no-parent-control")

try:
    from common.oh_no_parent_control_ui.diagnostic_events import configure_console, emit_failure, run_cli
    configure_console()
except Exception:
    sys.stderr.write("onpc.runtime startup failed\n")
    raise SystemExit(1) from None

try:
    from oh_no_parent_control_parent.main import main
except Exception:
    emit_failure("parent", "startup")
    sys.stderr.write("onpc.runtime startup failed\n")
    raise SystemExit(1) from None

raise SystemExit(run_cli(main, failure_component="parent"))
