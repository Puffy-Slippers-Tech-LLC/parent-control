// Development-only: all filenames and formats use the same validated helper.
// The helper confines reads to project test/log storage and exports only new
// caller-owned copies. No general root command or source modification is granted.
polkit.addRule(function(action, subject) {
    if (action.id === "com.puffyslippers.onpc.development.test-artifacts") {
        // Missing details are the caller's noninteractive pkcheck; execution
        // requests supply both fields and must match the installed root helper.
        if (((!action.lookup("user") && !action.lookup("program")) ||
             (action.lookup("user") === "root" &&
              action.lookup("program") === "/usr/local/libexec/onpc-test-artifacts")) &&
            subject.local && subject.active && subject.isInGroup("sudo")) {
            return polkit.Result.YES;
        }
        // Excluded callers are denied instead of opening an authentication dialog.
        return polkit.Result.NO;
    }
});
