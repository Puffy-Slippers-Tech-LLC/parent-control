# Private Python modules are loaded by our fixed launchers, not site-packages.
# Hash shipped bytes only after RPM's strip/shebang/other post-install passes.
%global __brp_python_bytecompile %{nil}
# Preserve late expansion of RPM's debug-package conditional. Eager expansion
# here suppresses find-debuginfo before RPM enables its generated debug packages.
%global onpc_spec_install_post %{macrobody:__spec_install_post}
%define __spec_install_post %{onpc_spec_install_post} \
    make --no-print-directory -C "%{_builddir}/%{buildsubdir}" _generate-package-activation-manifest DESTDIR="%{buildroot}" PACKAGE_DISTRIBUTION=fedora PAM_MODULE_DIR="%{_libdir}/security" \
%{nil}

%description
Oh No! Parent Control provides an administrator app, a per-child GNOME Shell
extension and a kiosk request station backed by shared per-account settings.
This development package targets Fedora Workstation 44 for local VM testing.

%prep
%autosetup

%build
%make_build check-release-version
%{__python3} -B packaging/render_lifecycle.py rpm --output rpm-lifecycle

%install
%set_build_flags
%{__make} --no-print-directory _install-product-files DESTDIR="%{buildroot}" \
    PACKAGE_DISTRIBUTION=fedora PAM_MODULE_DIR="%{_libdir}/security" \
    GENERATE_ACTIVATION_MANIFEST=0
install -d "%{buildroot}%{_datadir}/oh-no-parent-control/lifecycle"
install -m 0644 rpm-lifecycle/postinst "%{buildroot}%{_datadir}/oh-no-parent-control/lifecycle/"

%check
%{__python3} -B packaging/check_package.py
for script in rpm-lifecycle/rpm-*; do /bin/sh -n "$script"; done

%pretrans -f rpm-lifecycle/rpm-pretrans
%pre -f rpm-lifecycle/rpm-pre
%posttrans -f rpm-lifecycle/rpm-posttrans
%preun -f rpm-lifecycle/rpm-preun
%postun -f rpm-lifecycle/rpm-postun

%files
%license LICENSE COPYRIGHT NOTICE
%{_bindir}/oh-no-parent-control
%{_bindir}/oh-no-parent-control-child
%{_bindir}/oh-no-parent-control-parent
%{_bindir}/oh-no-parent-control-purge
%{_libexecdir}/oh-no-parent-control-*
%{_libdir}/security/pam_oh_no_parent_control.so
/usr/lib/oh-no-parent-control/
