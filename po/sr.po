#. Shared message: SAVE_GRANT_FAILED
msgid "Could not save the one-time grant. Please try again later."
msgstr "Једнократно одобрење није било могуће сачувати. Покушајте поново касније."

#. Shared message: SAVE_SCREEN_TIME_FAILED
msgid "Could not save screen-time settings. Please try again later."
msgstr "Подешавања времена пред екраном није било могуће сачувати. Покушајте поново касније."

#. Shared message: SAVE_APP_ACCESS_FAILED
msgid "Could not save app access. Please try again later."
msgstr "Приступ апликацијама није било могуће сачувати. Покушајте поново касније."

#. Shared message: EDIT_LINK
msgid "Edit link"
msgstr "Уреди везу"

#. Shared message: ERROR_CATEGORIES
#, python-format
msgid "Error categories: %(categories)s"
msgstr "Категорије грешака: %(categories)s"

#. Translators: The name operand is the child's display name, with escaped styling markup.
#, python-format
msgid "For %(name)s"
msgstr "За %(name)s"

#. Translators: Attachment sizes use the existing 1024-byte scale. Localize the unit.
#, python-format
msgid "%(size)s KB"
msgstr "%(size)s КБ"

#, python-format
msgid "%(size)s MB"
msgstr "%(size)s МБ"

#. Translators: Fractional hours, independent of integer plural rules.
#, python-format
msgid "%(count)g hours"
msgstr "%(count)g сата"

#, python-format
msgctxt "fractional hours below two"
msgid "%(count)g hours"
msgstr "%(count)g сата"

#. Shared message: TIME_REMAINING_NOTIFICATION
#, python-format
msgid "%(time)s left"
msgstr "Преостало време: %(time)s"

#. Shared message: TIME_REMAINING_SAVE_GAMES_NOTIFICATION
#, python-format
msgid "%(time)s left, save your games!"
msgstr "Преостало време: %(time)s, сачувај своје игре!"

