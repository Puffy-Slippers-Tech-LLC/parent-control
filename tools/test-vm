#!/usr/bin/python3 -IB
"""Control a configured VM through its installed, individually pinned identity."""
import os
import stat
import subprocess
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from dev_privileges import launch
from vm_selection import extract, vm_config

MAX_INPUT_BYTES = 64 * 1024 * 1024


def fixture_maintenance(args, configured):
    """Keep caller-owned inputs in one retained run until owned stop/restart."""
    if args == ['--fixture-maintenance', 'start']:
        args = ['start', '--fixture-maintenance']
    if not args or not (args[0] == 'sync-fixtures' or '--fixture-maintenance' in args):
        return None
    targets = vm_config.fixture_targets()
    if configured.name not in targets or args not in (
            ['start', '--fixture-maintenance'], ['sync-fixtures']):
        raise ValueError('fixture maintenance requires a qualified target and a fixed action')
    from dev_privileges import check
    from vm_pool import arguments as checkout_arguments, reservation
    from test_retention import Store
    from test_storage import directory, scratch_descriptors
    from fixture_execution import prepare
    import json
    check('/usr/local/libexec/onpc-test-runner')
    def invoke(options):
        return subprocess.run(['/usr/bin/pkexec', '--keep-cwd',
            '/usr/local/libexec/onpc-test-runner', *checkout_arguments(), 'vm', '--vm', configured.name,
            *options], cwd=Path(__file__).resolve().parents[1],
            pass_fds=scratch_descriptors(), check=False).returncode

    with reservation(configured.name):
        store = Store(directory('state') / ('retention-fixture-maintenance-' + configured.name))
        if args[0] == 'start':
            status = invoke(args)
            if status:
                return status
            try:
                # Start succeeded before rotating the former input owner. A refused
                # duplicate start cannot retire an existing guest's selected input.
                with store.session():
                    pass
            except BaseException:
                invoke(['stop'])
                raise
            return 0
        with store.opened() as fd:
            state = store.read(fd)
        if state is None:
            raise ValueError('start fixture maintenance before syncing fixtures')
        with store.session(run=state['run']):
            selection = prepare(target=targets[configured.name])
            return invoke(['sync-fixtures', '--fixture-selection',
                           json.dumps(selection.record(), sort_keys=True)])


def input_arguments(args):
    """Open input as the caller; privileged code receives only this descriptor."""
    controls = args[:args.index('--')] if '--' in args else args
    if '--input-file' not in controls:
        return args, None
    if not controls or controls[0] != 'exec' or controls.count('--input-file') != 1:
        raise ValueError('vm-probe: input-file requires exec')
    index = controls.index('--input-file')
    if index + 1 == len(controls) or controls[index + 1].startswith('-'):
        raise ValueError('vm-probe: input-file requires a path')
    path = controls[index + 1]
    updated = args[:index] + ['--stdin'] + args[index + 2:]
    from vm_selection import vm_config
    vm_config.guest_command_arguments(updated[1:])
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as error:
        raise ValueError('vm-probe: input file is unreadable or substituted') from error
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_INPUT_BYTES:
            raise ValueError('vm-probe: input must be a regular file at most 64 MiB')
        return updated, fd
    except BaseException:
        os.close(fd)
        raise

if __name__ == '__main__':
    if os.geteuid() == 0:
        sys.exit('test-vm: invoke as an unprivileged administrator')
    try:
        args, configured = extract(sys.argv[1:])
        if configured is None:
            import runpy
            runpy.run_path(str(Path(__file__).with_name('onpc-test-runner')))['selection'](
                Path(__file__).resolve().parents[1], ['vm', *args])
            sys.exit(0)
        status = fixture_maintenance(args, configured)
        if status is not None:
            sys.exit(status)
        # Keep the host selector before an exec command's -- boundary.
        args, input_fd = input_arguments(args)
        if input_fd is not None and input_fd != 0:
            os.dup2(input_fd, 0)
            os.close(input_fd)
        launch('/usr/local/libexec/onpc-test-runner', ['vm', '--vm', configured.name, *args])
    except (ValueError, OSError) as error:
        sys.exit('test-vm: ' + (str(error) if isinstance(error, ValueError) else 'refresh test tools with setup'))
