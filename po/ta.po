#, python-format
msgid "Attach at most %(MAX_ATTACHMENT_COUNT)s files."
msgstr "அதிகபட்சம் %(MAX_ATTACHMENT_COUNT)s கோப்புகளை இணைக்கவும்."

#. Shared message: ONE_OR_MORE_ATTACHMENTS_ARE_INVALID
msgid "One or more attachments are invalid."
msgstr "ஒன்று அல்லது அதற்கு மேற்பட்ட இணைப்புகள் செல்லாது."

