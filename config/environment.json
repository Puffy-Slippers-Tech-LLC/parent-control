{
  "agent": "codex",
  "agents": {
    "codex": {
      "defaults": {
        "frontier": { "model": "gpt-6.2-astra", "effort": "xhigh" },
        "workhorse": { "model": "gpt-6.2-sol", "effort": "high" },
        "bargain": { "model": "gpt-6.2-sol", "effort": "low" }
      },
      "capacity_fallbacks": { "workhorse": "frontier" }
    },
    "claude": {
      "defaults": {
        "frontier": { "model": "claude-fable-5-2", "effort": "xhigh" },
        "workhorse": { "model": "claude-opus-5-5", "effort": "high" },
        "bargain": { "model": "claude-haiku-5-5", "effort": "low" }
      }
    },
    "tools": {
      "fix-tests": { "model": "workhorse" },
      "execute-plan": { "model": "workhorse" },
      "sync-whatsnew": { "model": "workhorse" },
      "commit-skill-driver": { "model": "bargain" },
      "conflict-resolver": { "model": "workhorse" },
      "execution-plan-worker": { "model": "workhorse" },
      "execution-plan-monitor": { "model": "bargain" },
      "backend-reviewer": { "model": "frontier" }
    }
  },
  "snap_tests_enabled": true,
  "e2e_static_request_backdrop": true,
  "hosts": [
    {
      "name": "local",
      "enabled": "true",
      "default_host": "false",
      "transport": "local",
      "virt-manager": "/Data/virt-manager",
      "max_compute_unit": 3,
      "disk_concurrency": 1,
      "backup_root": "/Data/virt-manager/backups/onpc"
    },
    {
      "name": "myserver",
      "enabled": "true",
      "default_host": "true",
      "transport": "ssh",
      "virt-manager": "/Data/virt-manager",
      "ssh_port": 22,
      "backup_root": "/Data/virt-manager/backups/onpc",
      "max_compute_unit": 10,
      "disk_concurrency": 3
    }
  ],
  "branches": [
    { "name": "main", "host": "local", "repo_root": "/Data/Code/PST/parent-control" },
    { "name": "worktree", "host": "local", "repo_root": "/Data/Code/PST/parent-control1" },
    { "name": "test", "host": "myserver", "repo_root": "/Data/Code/PST/parent-control-test" },
    { "name": "others", "host": "myserver", "repo_root": "/Data/Code/PST/parent-control-others" }
  ],
  "launchers": [
    { "name": "fix-tests", "default_branch": "test" }
  ],
