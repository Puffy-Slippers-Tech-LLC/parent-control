#!/bin/sh
set -e

if [ "$1" = abort-remove ]; then
    /usr/libexec/oh-no-parent-control-uninstall --restore
    pam-auth-update --package \
        --disable malcontent \
        --enable oh-no-parent-control-session-limits \
        --enable oh-no-parent-control-kiosk-only </dev/null
fi

release_removal_guard() {
    if [ -f /var/lib/oh-no-parent-control/uninstall-broker-mask ]; then
        if [ "$(readlink /run/systemd/system/oh-no-parent-control-broker.service)" = /dev/null ]; then
            systemctl unmask --runtime oh-no-parent-control-broker.service >/dev/null
        fi
        rm -f /var/lib/oh-no-parent-control/uninstall-broker-mask
    fi
}

activate_broker() {
    # This D-Bus-activated unit is intentionally static. deb-systemd-invoke
    # skips inactive static units, including a broker stopped for migration.
    # Consult the same package-service policy before asking systemd directly.
    if [ ! -d /run/systemd/system ]; then
        echo 'oh-no-parent-control: deferring broker activation until systemd is running' >&2
        return
    fi
    broker_policy_status=0
    broker_policy_helper="${DPKG_ROOT:-}/usr/sbin/policy-rc.d"
    if [ -x "$broker_policy_helper" ]; then
        "$broker_policy_helper" oh-no-parent-control-broker.service "$1" || broker_policy_status=$?
    fi
    case "$broker_policy_status" in
        0|104) ;;
        101)
            echo 'oh-no-parent-control: broker activation deferred by policy-rc.d' >&2
            return
            ;;
        *)
            echo "oh-no-parent-control: broker activation policy failed (status $broker_policy_status)" >&2
            return 1
            ;;
    esac
    echo "oh-no-parent-control: broker activation: $1" >&2
    if ! systemctl --system "$1" oh-no-parent-control-broker.service; then
        echo 'oh-no-parent-control: broker activation failed; package configuration must be retried' >&2
        return 1
    fi
}

if [ "$1" = abort-remove ]; then
    release_removal_guard
fi

if [ "$1" = configure ]; then
    if [ -f /var/lib/oh-no-parent-control/uninstall-enforcement.json ]; then
        /usr/libexec/oh-no-parent-control-uninstall --restore
    fi
    /usr/libexec/oh-no-parent-control-migrate-state
    rm -f /var/lib/oh-no-parent-control/migration-in-progress
    release_removal_guard

    kiosk_user=oh-no-parent-control
    package_created_kiosk=0
    if ! getent passwd "$kiosk_user" >/dev/null; then
        adduser --disabled-password --gecos "Oh No! Parent Control" \
            --home "/home/$kiosk_user" --shell /bin/bash "$kiosk_user"
        kiosk_uid=$(id -u "$kiosk_user")
        printf '%s\n' "$kiosk_uid" \
            > /var/lib/oh-no-parent-control/package-created-kiosk-uid
        chown root:root \
            /var/lib/oh-no-parent-control/package-created-kiosk-uid
        chmod 0600 \
            /var/lib/oh-no-parent-control/package-created-kiosk-uid
        package_created_kiosk=1
    elif [ ! -f /var/lib/oh-no-parent-control/package-created-kiosk-uid ]; then
        # An administrator may already have created the reserved kiosk account.
        # Provision validates that it is non-root and non-administrative. Do
        # not create the ownership marker here: postrm must preserve an account
        # that this package did not create.
        echo 'oh-no-parent-control: using existing dedicated kiosk account; package removal will preserve it' >&2
    elif [ "$(id -u "$kiosk_user")" != \
           "$(cat /var/lib/oh-no-parent-control/package-created-kiosk-uid)" ]; then
        echo 'oh-no-parent-control: kiosk account no longer matches package ownership' >&2
        exit 1
    else
        package_created_kiosk=1
    fi
    if [ "$package_created_kiosk" -eq 1 ]; then
        # Reassert only package-owned account properties. A pre-existing
        # account is deliberately preserved on removal, so installation must
        # not irreversibly replace its password or identity fields.
        echo 'oh-no-parent-control: configuring package-owned kiosk account' >&2
        usermod --comment "Oh No! Parent Control" \
            --home "/home/$kiosk_user" --shell /bin/bash "$kiosk_user"
        passwd --delete "$kiosk_user"
    fi
    /usr/libexec/oh-no-parent-control-provision --kiosk-user "$kiosk_user"

    kiosk_gid=$(id -g "$kiosk_user")
    install -d -o "$kiosk_user" -g "$kiosk_gid" -m 0700 \
        "/home/$kiosk_user/.config" \
        "/home/$kiosk_user/.config/gnome-initial-setup"
    install -o "$kiosk_user" -g "$kiosk_gid" -m 0644 /dev/null \
        "/home/$kiosk_user/.config/gnome-initial-setup-done"
    install -o "$kiosk_user" -g "$kiosk_gid" -m 0644 /dev/null \
        "/home/$kiosk_user/.config/gnome-initial-setup/upgrade-26.04-done"

    pam-auth-update --package \
        --disable malcontent \
        --enable oh-no-parent-control-session-limits \
        --enable oh-no-parent-control-kiosk-only </dev/null
    chown root:sudo \
        /usr/share/applications/com.puffyslippers.OhNoParentControl.Parent.desktop
    chmod 0640 \
        /usr/share/applications/com.puffyslippers.OhNoParentControl.Parent.desktop

    # Ubuntu's Malcontent package ships sysusers definitions, but its service
    # startup can run before those accounts exist on a clean installation.
    # Create exactly the dependency-owned accounts required by its installed
    # units before retrying those units.
    echo 'oh-no-parent-control: provisioning Malcontent service accounts' >&2
    systemd-sysusers \
        malcontent-timer-extension-agent.conf \
        malcontent-timerd.conf \
        malcontent-webd.conf
    for service_user in \
            malcontent-timer-ext-agent \
            malcontent-timerd \
            malcontent-webd; do
        if ! getent passwd "$service_user" >/dev/null; then
            echo "oh-no-parent-control: required Malcontent service account was not created: $service_user" >&2
            exit 1
        fi
    done

    echo 'oh-no-parent-control: reloading systemd and D-Bus configuration' >&2
    systemctl --system daemon-reload
    invoke-rc.d dbus reload >/dev/null || true

    # fapolicyd does not enable itself when first installed. Enable every
    # persistent enforcement dependency, then let deb-systemd-invoke honor the
    # host's package-service start policy. A real startup failure must fail
    # package configuration instead of leaving enforcement silently absent.
    echo 'oh-no-parent-control: enabling and starting enforcement services' >&2
    systemctl enable \
        fapolicyd.service \
        malcontent-timerd.service \
        malcontent-timer-extension-agent.service >/dev/null
    deb-systemd-invoke start \
        fapolicyd.service \
        malcontent-timerd.service \
        malcontent-timer-extension-agent.service >/dev/null

    # Migration stops the broker even on an unchanged reinstall. Ensure it is
    # running after every configure, without restarting an already-active
    # broker unless the changed payload requires reconciliation.
    broker_action=start
    pending=/var/lib/oh-no-parent-control/package-activation-pending
    if [ -f "$pending" ]; then
        previous=/var/lib/oh-no-parent-control/previous-package-activation.json
        current=/usr/share/oh-no-parent-control/package-activation.json
        impacts=$(/usr/libexec/oh-no-parent-control-package-activation \
            changed-impacts --old "$previous" --new "$current")
        case "$impacts" in
            *process-restart*|*session-renewal*)
                # Starting the broker reasserts per-child activation. A
                # running Shell keeps its loaded code; the next session reads
                # the updated immutable system extension payload.
                broker_action=restart
                ;;
        esac
        case "$impacts" in
            *reboot*)
                if [ ! -e /run/reboot-required ]; then
                    printf '%s\n' '*** System restart required ***' > /run/reboot-required
                fi
                touch /run/reboot-required.pkgs
                if ! grep -Fxq 'oh-no-parent-control' /run/reboot-required.pkgs; then
                    printf '%s\n' 'oh-no-parent-control' >> /run/reboot-required.pkgs
                fi
                chmod 0644 /run/reboot-required /run/reboot-required.pkgs
                ;;
        esac
    fi
    activate_broker "$broker_action"
    # Preserve the comparison on failure so a configure retry repeats the
    # required activation and cannot lose a pending reboot requirement.
    if [ -f "$pending" ]; then
        rm -f "$previous" "$pending"
    fi
fi

#DEBHELPER#

exit 0
