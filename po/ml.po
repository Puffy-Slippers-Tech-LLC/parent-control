msgid "No child account is selected."
msgstr "കുട്ടിയുടെ അക്കൗണ്ട് തിരഞ്ഞെടുത്തിട്ടില്ല."

#. Shared message: SELECTED_CHILD
msgid "Selected child"
msgstr "തിരഞ്ഞെടുത്ത കുട്ടി"

#. Shared message: PARENT_APP_MENU
msgid "Parent app menu"
msgstr "മാതാപിതാക്കളുടെ ആപ്പിന്റെ മെനു"

#. Shared message: OPEN_PREFERENCES_HELP_AND_PRODUCT_INFORMATION
msgid "Open preferences, help and product information."
msgstr "മുൻഗണനകൾ, സഹായം, ഉൽപ്പന്ന വിവരങ്ങൾ എന്നിവ തുറക്കുക."

#. Shared message: FEEDBACK
msgid "Feedback"
msgstr "അഭിപ്രായം"

#. Shared message: SEND_FEEDBACK_ABOUT_THE_APP
msgid "Send feedback about the app."
msgstr "ആപ്പിനെക്കുറിച്ചുള്ള അഭിപ്രായം അയയ്ക്കുക."

#. Shared message: CHOOSE_THE_CHILD_WHOSE_SCREEN_TIME_AND_APP_POLICY_ARE_DISPLAYED
msgid "Choose the child whose screen time and app policy are displayed."
msgstr "ആരുടെ സ്ക്രീൻ സമയവും ആപ്പ് നയവും കാണിക്കണമോ ആ കുട്ടിയെ തിരഞ്ഞെടുക്കുക."

#. Shared message: REVOKE_ONE_TIME_ACCESS
msgid "Revoke one-time access"
msgstr "ഒറ്റത്തവണ പ്രവേശനം പിൻവലിക്കുക"

#. Shared message: REMOVE_THE_SELECTED_CHILD_S_ACTIVE_ONE_TIME_GRANT_AFTER_CONFIRMA
msgid "Remove the selected child's active one-time grant after confirmation."
msgstr "സ്ഥിരീകരിച്ച ശേഷം തിരഞ്ഞെടുത്ത കുട്ടിയുടെ നിലവിലുള്ള ഒറ്റത്തവണ അനുമതി നീക്കുക."

#. Shared message: SCREEN_LIMITS
msgid "Screen Limits"
msgstr "സ്ക്രീൻ നിയന്ത്രണങ്ങൾ"

#. Shared message: SCREEN_TIME_LIMIT
msgid "Screen time limit"
msgstr "സ്ക്രീൻ സമയപരിധി"

#. Shared message: ENABLE_OR_DISABLE_DAILY_SCREEN_TIME_CONTROL_FOR_THE_SELECTED_CHI
msgid "Enable or disable daily screen-time control for the selected child."
msgstr "തിരഞ്ഞെടുത്ത കുട്ടിയുടെ ദിവസേനയുള്ള സ്ക്രീൻ സമയ നിയന്ത്രണം പ്രവർത്തനക്ഷമമാക്കുക അല്ലെങ്കിൽ പ്രവർത്തനരഹിതമാക്കുക."

#. Shared message: DAILY_TIME_ALLOWANCE
msgid "Daily time allowance"
msgstr "ദിവസേന അനുവദിച്ച സമയം"

#. Shared message: CHOOSE_THE_SELECTED_CHILD_S_DAILY_SCREEN_TIME_ALLOWANCE
msgid "Choose the selected child's daily screen-time allowance."
msgstr "തിരഞ്ഞെടുത്ത കുട്ടിയുടെ ദിവസേനയുള്ള സ്ക്രീൻ സമയം തിരഞ്ഞെടുക്കുക."

#. Shared message: CUSTOM_DAILY_ALLOWANCE
msgid "Custom daily allowance"
msgstr "സ്വയം നിശ്ചയിച്ച പ്രതിദിന സമയം"

#. Shared message: ENTER_A_WHOLE_NUMBER_OF_MINUTES_FROM_ZERO_THROUGH_1439
msgid "Enter a whole number of minutes from zero through 1439."
msgstr "പൂജ്യം മുതൽ 1439 വരെ മിനിറ്റുകളുടെ പൂർണസംഖ്യ നൽകുക."

#. Shared message: TODAY_S_REMAINING_TIME
msgid "Today's remaining time"
msgstr "ഇന്ന് ബാക്കിയുള്ള സമയം"

#. Shared message: EXPAND_OR_COLLAPSE_THE_DAILY_AND_ONE_TIME_REMAINING_TIME_CALCULA
msgid "Expand or collapse the daily and one-time remaining-time calculation."
msgstr "ദിവസേനയും ഒറ്റത്തവണയും അനുവദിച്ച സമയത്തിന്റെ ബാക്കി കണക്കുകൂട്ടൽ വികസിപ്പിക്കുക അല്ലെങ്കിൽ ചുരുക്കുക."

#. Shared message: APP_LIMITS
msgid "App Limits"
msgstr "ആപ്പ് നിയന്ത്രണങ്ങൾ"

#. Shared message: SEARCH_INSTALLED_APPS
msgid "Search installed apps"
msgstr "സ്ഥാപിച്ച ആപ്പുകൾ തിരയുക"

#. Revoke confirmation: only currently running apps with a temporary soft block.
msgid "These running soft blocked apps will be closed:"
msgstr "താൽക്കാലികമായി തടഞ്ഞിരിക്കുന്ന, പ്രവർത്തിച്ചുകൊണ്ടിരിക്കുന്ന ഈ ആപ്പുകൾ അടയ്ക്കും:"

#. Complete product-owned PolicyKit authorization prompt.
#, python-format
msgid "Grant %(target)s access?\nRequested time: %(duration)s."
msgstr "%(target)s-ന് പ്രവേശനം അനുവദിക്കണോ?\nഅഭ്യർത്ഥിച്ച സമയം: %(duration)s."

#. Complete prompt including temporary access to soft blocked apps.
#, python-format
msgid "Grant %(target)s access?\nRequested time: %(duration)s.\nAllow soft blocked apps for this grant."
msgstr "%(target)s-ന് പ്രവേശനം അനുവദിക്കണോ?\nഅഭ്യർത്ഥിച്ച സമയം: %(duration)s.\nഈ അനുമതിയുടെ കാലയളവിൽ താൽക്കാലിക അനുമതി നൽകാവുന്ന തടഞ്ഞ ആപ്പുകൾ അനുവദിക്കുക."

#. Separator between nonzero duration units.
msgctxt "duration list separator"
msgid ", "
msgstr ", "

msgid "Restart required"
msgstr "പുനരാരംഭിക്കേണ്ടതുണ്ട്"

msgid "Reboot now"
msgstr "ഇപ്പോൾ പുനരാരംഭിക്കുക"

msgid "Restart the computer for Oh No! Parent Control to work properly."
msgstr "Oh No! Parent Control ശരിയായി പ്രവർത്തിക്കാൻ കമ്പ്യൂട്ടർ പുനരാരംഭിക്കുക."

#. Shared message: SEARCH_LANGUAGES
msgid "Search languages"
msgstr "ഭാഷകൾ തിരയുക"

#. Shared message: FILTER_THE_SELECTED_CHILD_S_AVAILABLE_APPLICATIONS
