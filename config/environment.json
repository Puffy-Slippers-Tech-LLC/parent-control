{
  "agent": "codex",
  "agents": {
    "codex": {
      "defaults": {
        "frontier": { "model": "gpt-6.2-astra", "effort": "xhigh" },
        "workhorse": { "model": "gpt-6.2-sol", "effort": "high" },
        "bargain": { "model": "gpt-6.2-sol", "effort": "low" }
      },
      "capacity_fallbacks": { "workhorse": "frontier" }
    },
    "claude": {
      "defaults": {
        "frontier": { "model": "claude-opus-5-5", "effort": "xhigh" },
        "workhorse": { "model": "claude-opus-5-5", "effort": "high" },
        "bargain": { "model": "claude-haiku-5-5", "effort": "low" }
      }
    },
    "tools": {
      "fix-tests": { "model": "workhorse" },
      "execute-plan": { "model": "workhorse" },
      "sync-whatsnew": { "model": "bargain" },
      "commit-skill-driver": { "model": "bargain" },
      "conflict-resolver": { "model": "workhorse" },
      "execution-plan-worker": { "model": "workhorse" },
      "execution-plan-monitor": { "model": "bargain" },
      "backend-reviewer": { "model": "frontier" }
    }
  },
  "snap_tests_enabled": true,
  "e2e_static_request_backdrop": true,
  "hosts": [
    {
      "name": "local",
      "enabled": "true",
      "default_host": "false",
      "transport": "local",
      "virt-manager": "/Data/virt-manager",
      "max_compute_unit": 13.5,
      "disk_concurrency": 1,
      "host_test_concurrency": 4,
      "backup_root": "/Data/virt-manager/backups/onpc"
    },
    {
      "name": "myserver",
      "enabled": "true",
      "default_host": "true",
      "transport": "ssh",
      "virt-manager": "/Data/virt-manager",
      "ssh_port": 22,
      "backup_root": "/Data/virt-manager/backups/onpc",
      "max_compute_unit": 40.5,
      "host_test_concurrency": 8,
      "disk_concurrency": 4,
      "kvm_halt_poll_ns": 0
    }
  ],
  "branches": [
    { "name": "main", "host": "local", "repo_root": "/Data/Code/PST/parent-control" },
    { "name": "worktree", "host": "local", "repo_root": "/Data/Code/PST/parent-control1" },
    { "name": "test", "host": "myserver", "repo_root": "/Data/Code/PST/parent-control-test" },
    { "name": "others", "host": "myserver", "repo_root": "/Data/Code/PST/parent-control-others" }
  ],
  "launchers": [
    { "name": "fix-tests", "default_branch": "test" }
  ],
  "vm_configs": {
    "vm_config_general": { "compute_unit": 4.5, "vm_tags": "general", "enabled": "true", "host": "myserver", "disk_anchor": "/Data/virt-manager/{name}.qcow2", "vm_config_xml": "config/{host}-vm-template.xml", "owning_branch": "" },
    "vm_config_general_u26": { "parent_config": "vm_config_general", "name": "onpc-Ubuntu26.04-{id}", "iso": "ubuntu-26.04.*-desktop-amd64.iso" },
    "vm_config_general_f44": { "parent_config": "vm_config_general", "name": "onpc-Fedora44-{id}", "iso": "Fedora-Workstation-Live-44-*.x86_64.iso", "install_iso": "Fedora-Everything-netinst-x86_64-44-*.iso" },
    "vm_config_general_f45": { "parent_config": "vm_config_general", "name": "onpc-Fedora45-{id}", "iso": "Fedora-Workstation-Live-45-*.x86_64.iso", "install_iso": "Fedora-Everything-netinst-x86_64-45-*.iso" },
    "vm_config_heavy_u26": { "parent_config": "vm_config_general_u26", "compute_unit": 9, "vm_tags": "heavy" },
    "vm_config_heavy_f44": { "parent_config": "vm_config_general_f44", "compute_unit": 9, "vm_tags": "heavy" },
    "vm_config_heavy_f45": { "parent_config": "vm_config_general_f45", "compute_unit": 9, "vm_tags": "heavy" }
  },
  "families": [
    {
      "family": "ubuntu26.04-x86_64",
      "id": "u26",
      "parent_config": "vm_config_general_u26",
      "package_format": "deb",
      "fixture_path": "common/ubuntu/common",
      "vms": [
        { "id": 11, "host": "local" },
        { "id": 101 },
        { "id": 102 },
