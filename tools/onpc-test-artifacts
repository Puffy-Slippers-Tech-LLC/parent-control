#!/usr/bin/python3 -I
"""Inspect project test artifacts; never execute commands or change sources."""

import argparse
from contextlib import contextmanager, ExitStack
import json
import os
from pathlib import Path
import pwd
import re
import stat
import sys
import tempfile
import zipfile

CHECKOUT = None  # Replaced with the runtime resolver by install_test_runner.py.


def caller():
    value = os.environ.get('PKEXEC_UID', '')
    if os.geteuid() != 0 or not value.isascii() or not value.isdecimal() or int(value) <= 0:
        raise ValueError('pkexec with an unprivileged caller is required')
    account = pwd.getpwuid(int(value))
    return account.pw_uid, account.pw_gid


def source_parts(source, checkout):
    """Accept all names/extensions under project storage, never arbitrary host files."""
    parts = source.split('/')
    if parts[0] or any(p in ('', '.', '..') for p in parts[1:]):
        raise ValueError('an absolute path without traversal is required')
    path = Path(source)
    roots = [Path('/var/log/oh-no-parent-control'),
             Path('/var/tmp/oh-no-parent-control-artifacts')]
    roots.extend(Path(checkout) / name for name in ('tests', 'artifacts', 'output'))
    temporary = (len(parts) >= 3 and
                 ((parts[1] == 'tmp' and re.fullmatch(r'onpc-[A-Za-z0-9_.-]+', parts[2])) or
                  (len(parts) >= 4 and parts[1:3] == ['var', 'tmp'] and
                   re.fullmatch(r'onpc-[A-Za-z0-9_.-]+', parts[3]))))
    if not temporary and not any(path.is_relative_to(root) for root in roots):
        raise ValueError('source is outside project test and log storage')
    return parts[1:]


@contextmanager
def open_source(source, checkout, uid):
    parts = source_parts(source, checkout)
    with ExitStack() as stack:
        def opened(name, flags, parent=None):
            fd = os.open(name, flags | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
            stack.callback(os.close, fd)
            return fd

        parent = opened('/', os.O_RDONLY | os.O_DIRECTORY)
        for name in parts[:-1]:
            parent = opened(name, os.O_RDONLY | os.O_DIRECTORY, parent)
        fd = opened(parts[-1], os.O_RDONLY | os.O_NONBLOCK, parent)
        info = os.fstat(fd)
        if info.st_uid not in (0, uid):
            raise ValueError('artifact must belong to root or the invoking account')
        if not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
            raise ValueError('only regular files and directories are supported')
        if stat.S_ISREG(info.st_mode) and info.st_nlink != 1:
            raise ValueError('hard-linked artifacts are refused')
        yield fd, info


def copy_bytes(fd, output, count):
    # Bounded by the original size (or requested slice), even for a growing log.
    while count:
        chunk = os.read(fd, min(count, 65536))
        if not chunk:
            break
        output.write(chunk)
        count -= len(chunk)


def export(fd, info, source, uid, gid):
    """Create a new private caller-owned copy; no caller-selected write target."""
    sys.path.insert(0, str(Path(CHECKOUT) / 'tools'))
    import test_retention
    from test_storage import directory as storage_directory
    previous_uid, previous_gid = os.geteuid(), os.getegid()
    try:
        os.setegid(gid)
        os.seteuid(uid)
        parent = storage_directory('exports')
        with test_retention.Store(parent / 'retention').session():
            directory = Path(test_retention.allocate(tempfile.mkdtemp,
                prefix='onpc-artifact-export-', dir=parent))
            destination = directory / Path(source).name
            with destination.open('xb') as output:
                os.fchmod(output.fileno(), 0o600)
                copy_bytes(fd, output, info.st_size)
                output.flush()
                os.fsync(output.fileno())
            return str(destination)
    finally:
        os.seteuid(previous_uid)
        os.setegid(previous_gid)


def nonnegative(value):
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError('expected a nonnegative byte count')
    return number


def canonical_consumer(value, encode):
    def unique(pairs):
        result = {}
        for key, item in pairs:
            if key in result:
                raise ValueError('bundle: duplicate consumer key')
            result[key] = item
        return result

    def nonfinite(_value):
        raise ValueError('bundle: nonfinite consumer number')

    consumer = json.loads(value, object_pairs_hook=unique, parse_constant=nonfinite)
    if not isinstance(consumer, dict) or value.encode('utf-8') != encode(consumer):
        raise ValueError('bundle: consumer must be one canonical JSON object')
    return consumer


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    actions = parser.add_subparsers(dest='action', required=True)
    for action in ('read', 'tail', 'list', 'stat', 'export'):
        command = actions.add_parser(action, allow_abbrev=False)
        command.add_argument('source')
        if action in ('read', 'tail'):
            command.add_argument('--bytes', type=nonnegative, default=8000)
        if action == 'read':
            command.add_argument('--offset', type=nonnegative, default=0)
    for action in ('bundle-plan', 'bundle-export'):
        command = actions.add_parser(action, allow_abbrev=False)
        command.add_argument('--plan')
        command.add_argument('--target', action='append', default=[])
        command.add_argument('--source', action='append', default=[])
        command.add_argument('--bundle', action='append', default=[])
        command.add_argument('--reference', action='append', default=[])
        command.add_argument('--record-reference', action='append', default=[])
        command.add_argument('--consumer', action='append', default=[])
        if action == 'bundle-plan':
            command.add_argument('--summary', action='store_true')
        if action == 'bundle-export':
            command.add_argument('--expect', required=True)
            command.add_argument('--defer-cleanup', action='store_true')
    for action in ('bundle-list', 'bundle-read'):
        command = actions.add_parser(action, allow_abbrev=False)
        command.add_argument('source')
        if action == 'bundle-list':
            command.add_argument('--summary', action='store_true')
            command.add_argument('--path')
        if action == 'bundle-read':
            selector = command.add_mutually_exclusive_group(required=True)
            selector.add_argument('--path')
            selector.add_argument('--record-id')
            command.add_argument('--member-id')
            command.add_argument('--closure-sha256')
            command.add_argument('--bytes', type=nonnegative, default=8000)
            command.add_argument('--offset', type=nonnegative, default=0)
    actions.add_parser('bundle-finish', allow_abbrev=False)
    actions.add_parser('bundle-recover', allow_abbrev=False)
    args = parser.parse_args(argv)
    if args.action == 'bundle-read':
        structured = (args.record_id, args.member_id, args.closure_sha256)
        if any(value is not None for value in structured) and (
                args.path is not None or any(value is None for value in structured)):
            parser.error('--record-id, --member-id and --closure-sha256 are required together, without --path')
        if args.record_id is not None and any(
                re.fullmatch(r'[0-9a-f]{64}', value) is None for value in structured):
            parser.error('record, member and closure identities must be lowercase SHA-256 values')
    if args.action in ('bundle-plan', 'bundle-export'):
        if bool(args.record_reference) != bool(args.consumer) or len(args.consumer) > 1:
            parser.error('--record-reference requires exactly one --consumer, and conversely')
    try:
        if CHECKOUT is None:
            raise ValueError('installation required')
        uid, gid = caller()
        if args.action.startswith('bundle-'):
            sys.dont_write_bytecode = True
            sys.path.insert(0, str(Path(CHECKOUT) / 'tools'))
            import evidence_bundle
            if args.action in ('bundle-plan', 'bundle-export'):
                structured = {}
                if args.record_reference:
                    consumer = canonical_consumer(args.consumer[0], evidence_bundle.encoded)
                    # This is transport, not authority: Selection validates the
                    # declaration against the authenticated plan/check owner.
                    structured = dict(record_references=args.record_reference, consumer=consumer)
                namespace = None
                if args.plan is not None:
                    from execution_plan import Plan, plan_namespace
                    namespace = plan_namespace(Plan.load(Path(CHECKOUT), args.plan).path)
                try:
                    with evidence_bundle.Selection(CHECKOUT, uid, gid, args.target,
                                                   args.source, args.bundle,
                                                   plan_namespace=namespace,
                                                   references=args.reference, **structured) as selection:
                        result = (selection.plan() if args.action == 'bundle-plan' else
                                  evidence_bundle.export(selection, expected=args.expect,
                                                         defer_cleanup=args.defer_cleanup))
                except evidence_bundle.EvidenceUnavailable as error:
                    if namespace is None:
                        raise
                    print(json.dumps(error.payload(), sort_keys=True), file=sys.stderr)
                    return 3
            elif args.action == 'bundle-finish':
                result = {'cleanup_complete': True,
                          'retirement_finished': evidence_bundle.finish(CHECKOUT, uid, gid)}
            elif args.action == 'bundle-recover':
                evidence_bundle.recover(CHECKOUT, uid, gid)
                result = {'cleanup_complete': True}
            else:
                result = evidence_bundle.inspect(CHECKOUT, uid, gid, args.source, **(
                    dict(offset=args.offset, count=args.bytes, **(
                        dict(member=args.path) if args.path is not None else
                        dict(record_id=args.record_id, member_id=args.member_id,
                             closure_sha256=args.closure_sha256)))
                    if args.action == 'bundle-read' else {}))
            if isinstance(result, bytes):
                sys.stdout.buffer.write(result)
            else:
                if args.action == 'bundle-list' and args.path is not None:
                    result['manifest']['files'] = [entry for entry in result['manifest']['files']
                                                  if entry['path'] == args.path]
                    if not result['manifest']['files']:
                        raise ValueError('bundle: original path is not in the manifest')
                if getattr(args, 'summary', False):
                    inventory = {}
                    for entry in result['manifest'].pop('files'):
                        item = inventory.setdefault(entry['allocation']['path'],
                                                    dict(files=0, bytes=0, allocated_bytes=0))
                        item['files'] += 1
                        item['bytes'] += entry['bytes']
                        item['allocated_bytes'] += entry['allocated_bytes']
                    result['inventory'] = inventory
                print(json.dumps(result, sort_keys=True))
            return 0
        with open_source(args.source, CHECKOUT, uid) as (fd, info):
            directory = stat.S_ISDIR(info.st_mode)
            if args.action == 'stat':
                print(json.dumps({'kind': 'directory' if directory else 'file',
                                  'bytes': info.st_size, 'mode': oct(stat.S_IMODE(info.st_mode)),
                                  'mtime_ns': info.st_mtime_ns}))
            elif args.action == 'list':
                if not directory:
                    raise ValueError('list requires a directory')
                print(json.dumps(sorted(os.listdir(fd))))
            else:
                if directory:
                    raise ValueError('this operation requires a regular file')
                if args.action == 'export':
                    print(export(fd, info, args.source, uid, gid))
                else:
                    offset = (max(0, info.st_size - args.bytes) if args.action == 'tail'
                              else args.offset)
                    os.lseek(fd, offset, os.SEEK_SET)
                    copy_bytes(fd, sys.stdout.buffer, min(args.bytes, max(0, info.st_size - offset)))
        return 0
    except (ValueError, KeyError, OSError, TypeError, zipfile.BadZipFile, RuntimeError) as error:
        # Source contents and account/path details belong only in requested output.
        detail = str(error) if isinstance(error, ValueError) else type(error).__name__
        print(f'test-artifacts: {detail}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
