#!/usr/bin/python3 -IB
"""Prepare guest accounts/tools and replace the test VM baseline. The VM must be off."""
import argparse
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tests/integration'))
sys.path.insert(0, str(Path(__file__).resolve().parent))
from test_account_password import read_password
from dev_privileges import check
from baseline_messages import help_message
from vm_selection import registry, select, interactive_choice

HELPER = '/usr/local/libexec/onpc-setup'


def arguments(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--mode', required=True, choices=('auto', 'manual'),
                        help='auto: restore baseline and update guest; manual: prepare current VM state')
    parser.add_argument('--vm', help='exact name in config/test-vm.json; prompts when omitted')
    parser.add_argument('--y', action='store_true',
                        help='proceed without y/n confirmation; use for authorized launcher/session work')
    parser.epilog = help_message()
    # Show the complete, short usage reminder for missing options or values.
    def error(message):
        parser.print_help(sys.stderr)
        parser.exit(2, '\nPlease choose --mode auto or --mode manual. ' + message + '\n')
    parser.error = error
    return parser.parse_args(argv)


def choose_vm():
    names = list(registry())
    if sys.stdin.isatty() and sys.stdout.isatty() and os.environ.get('TERM', '') not in ('', 'dumb'):
        return names[interactive_choice(names)]
    print('Choose a VM from config/test-vm.json:')
    for number, name in enumerate(names, 1):
        print(f'  {number}. {name}')
    while True:
        try:
            answer = input(f'Select VM [1-{len(names)}]: ').strip()
        except (EOFError, KeyboardInterrupt) as error:
            raise ValueError('VM selection cancelled; supply --vm NAME to proceed') from error
        if answer.isascii() and answer.isdecimal():
            number = int(answer)
            if 1 <= number <= len(names):
                return names[number - 1]
        print(f'Please enter a number from 1 to {len(names)}.')


def main(argv=None):
    args = arguments(argv)
    try:
        if args.vm is None:
            args.vm = choose_vm()
        select(args.vm)
        if os.geteuid() == 0:
            raise ValueError('invoke as an unprivileged administrator')
        read_password(ROOT)
        check(HELPER)
        status = subprocess.run(
            ['/usr/bin/pkexec', '--keep-cwd', HELPER, 'prepare-baseline', '--mode', args.mode,
             *(['--y'] if args.y else []), '--vm', args.vm],
            cwd=ROOT,
            env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'},
        ).returncode
        if status == 3:  # Operator declined; no baseline was prepared.
            print('prepare-baseline: cancelled; no baseline snapshot was prepared.')
            return 0
        if status:
            return status
        # Pin the accepted UUID only after successful baseline reconciliation.
        status = subprocess.run([str(ROOT / 'setup.sh'), '--test-tools-only'], cwd=ROOT).returncode
        if status == 0:
            print(f'prepare-baseline: onpc_baseline prepared and accepted for {args.vm}.')
        return status
    except (ValueError, OSError) as error:
        print('prepare-baseline: ' + str(error), file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
