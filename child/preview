#!/usr/bin/env bash
set -euo pipefail

child_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
preview_root="$(mktemp -d)"
# shellcheck source=preview-orchestration.sh
source "$child_dir/preview-orchestration.sh"

onpc_preview_configure "$child_dir" "$preview_root"

onpc_preview_exit() {
    local status=$?
    trap - EXIT HUP INT TERM
    onpc_preview_cleanup || status=1
    exit "$status"
}

onpc_preview_exit_on_signal() {
    local signal=$1 status
    trap - EXIT HUP INT TERM
    printf 'Received %s; stopping the nested child preview.\n' "$signal" >&2
    onpc_preview_cleanup || true
    case $signal in
        HUP) status=129 ;;
        INT) status=130 ;;
        TERM) status=143 ;;
    esac
    exit "$status"
}

trap onpc_preview_exit EXIT
trap 'onpc_preview_exit_on_signal HUP' HUP
trap 'onpc_preview_exit_on_signal INT' INT
trap 'onpc_preview_exit_on_signal TERM' TERM
onpc_preview_require_dependencies
onpc_preview_prepare_environment
# Mutter Devkit requires a PipeWire context.  Keep it, the session bus, and
# accessibility registry private to this disposable preview so it cannot
# connect to or alter the developer's desktop services.
onpc_preview_start_private_bus
onpc_preview_start_accessibility
onpc_preview_start_pipewire
onpc_preview_enable_host_devkit_viewer

echo 'Starting child preview in a nested GNOME Shell. Edit child files to reload.'
while true; do
    onpc_preview_generation=$((onpc_preview_generation + 1))
    onpc_preview_start "$onpc_preview_generation"
    # Task 10A's interactive wrapper uses the process-liveness readiness
    # contract. Task 10B replaces it with an observable Shell readiness probe.
    ONPC_PREVIEW_READY_PROBE=onpc_preview_process_is_running \
        onpc_preview_wait_for_readiness "$onpc_preview_shell_pid" "$onpc_preview_generation"
    onpc_preview_record_mutter_devkit
    printf '%s\n' 'Nested GNOME Shell is running. Edit child files to reload, or press Ctrl+C here to stop it.'
    if onpc_preview_wait_for_reload "$onpc_preview_shell_pid"; then
        onpc_preview_stop_shell
        continue
    fi
    onpc_preview_stop_shell
    break
done
