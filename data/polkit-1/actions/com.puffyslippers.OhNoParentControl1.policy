<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Puffy Slippers</vendor>
  <vendor_url>https://puffyslippers.com/</vendor_url>
  <action id="com.puffyslippers.OhNoParentControl1.request-access">
    <description>Authorize additional time and app access for a selected account</description>
    <message>Grant $(target-account) $(requested-duration)$(soft-blocked-apps)?</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
